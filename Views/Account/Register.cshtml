@model SaaSBarberia.Models.RegisterViewModel
@{
    Layout = null;
    var primaryColor = Model?.ColorPrimario ?? ViewBag.ColorPrimario as string ?? "#1a1a1a";
    var secondaryColor = Model?.ColorSecundario ?? ViewBag.ColorSecundario as string ?? "#d4af37";
    var nombreNegocio = Model?.NombreNegocio ?? ViewBag.NombreNegocio as string ?? "SaaS Barbería";
    var logoUrl = Model?.RutaLogo ?? ViewBag.RutaLogo as string;
    var slugTenant = Model?.SlugTenant ?? ViewBag.SlugTenant as string ?? "";
    var tenantId = Model?.TenantId ?? ViewBag.TenantId ?? 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Cliente - @nombreNegocio</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Frameworks & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --tenant-primary: @primaryColor;
            --tenant-secondary: @secondaryColor;
        }

        .register-card {
            width: 100%;
            max-width: 480px;
            background: rgba(31, 41, 55, 0.95) !important;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
        }

        .sede-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--tenant-secondary);
            color: var(--tenant-secondary);
        }

        .sede-avatar {
            width: 68px;
            height: 68px;
            object-fit: cover;
            border-radius: 18px;
            border: 2px solid var(--tenant-secondary);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        }

        .sede-avatar-icon {
            width: 68px;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid var(--tenant-secondary);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        }

        .form-control {
            background-color: #111827 !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            color: #ffffff !important;
            border-radius: 10px;
            padding: 10px 14px;
            transition: all 0.2s ease-in-out;
        }

        .form-control:focus {
            border-color: var(--tenant-secondary) !important;
            box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.2) !important;
        }

        .btn-register-tenant {
            background-color: var(--tenant-secondary) !important;
            border-color: var(--tenant-secondary) !important;
            color: #0b0f17 !important;
            font-weight: 700;
            letter-spacing: 0.3px;
            border-radius: 10px;
            padding: 11px 16px;
            transition: all 0.25s ease;
        }

        .btn-register-tenant:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }

        .toggle-password-btn {
            background: transparent;
            border: none;
            color: #9ca3af;
        }
        .toggle-password-btn:hover {
            color: #ffffff;
        }
    </style>
</head>
<body class="saas-dark-luxury d-flex align-items-center justify-content-center min-vh-100 p-3 py-5">

    <div class="card register-card p-4 p-md-5 my-auto">
        <!-- Encabezado de la Barbería / Sede -->
        <div class="text-center mb-4">
            <div class="mb-3 d-flex justify-content-center">
                @if (!string.IsNullOrEmpty(logoUrl))
                {
                    <img src="@logoUrl" alt="@nombreNegocio" class="sede-avatar" />
                }
                else
                {
                    <div class="sede-avatar-icon">
                        💈
                    </div>
                }
            </div>

            <div class="sede-badge mb-2">
                <i class="bi bi-geo-alt-fill"></i> Sede Oficial
            </div>

            <h2 class="fw-bold text-white mb-1">@nombreNegocio</h2>
            <p class="text-secondary small mb-0">Portal de Registro de Clientes</p>
        </div>

        <!-- Formulario de Registro -->
        <form asp-controller="Account" asp-action="Register" asp-route-slugTenant="@slugTenant" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <!-- Input oculto obligatorio del TenantId -->
            <input type="hidden" name="TenantId" value="@tenantId" />

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small p-2 mb-3 d-block" })

            <!-- Nombre Completo -->
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label text-light small fw-semibold">
                    <i class="bi bi-person-fill me-1" style="color: var(--tenant-secondary);"></i> Nombre Completo
                </label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Carlos Gómez" required autofocus />
                <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Correo Electrónico -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label text-light small fw-semibold">
                    <i class="bi bi-envelope-at-fill me-1" style="color: var(--tenant-secondary);"></i> Correo Electrónico
                </label>
                <input asp-for="Email" type="email" class="form-control" placeholder="carlos@correo.com" required />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Teléfono / WhatsApp -->
            <div class="mb-3">
                <label asp-for="Telefono" class="form-label text-light small fw-semibold">
                    <i class="bi bi-whatsapp me-1" style="color: var(--tenant-secondary);"></i> Teléfono / WhatsApp (Opcional)
                </label>
                <input asp-for="Telefono" type="tel" class="form-control" placeholder="Ej: 3001234567" />
                <span asp-validation-for="Telefono" class="text-danger small mt-1 d-block"></span>
                <span class="text-secondary" style="font-size: 0.72rem;">Recibirás confirmaciones y recordatorios de tus citas.</span>
            </div>

            <!-- Contraseña -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label text-light small fw-semibold">
                    <i class="bi bi-shield-lock-fill me-1" style="color: var(--tenant-secondary);"></i> Contraseña
                </label>
                <div class="input-group">
                    <input asp-for="Password" type="password" id="inputPassword" class="form-control" placeholder="Mínimo 6 caracteres" required />
                    <button class="btn btn-outline-secondary toggle-password-btn" type="button" onclick="togglePasswordVisibility('inputPassword', 'eyeIcon1')">
                        <i class="bi bi-eye" id="eyeIcon1"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Confirmar Contraseña -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label text-light small fw-semibold">
                    <i class="bi bi-check2-circle me-1" style="color: var(--tenant-secondary);"></i> Confirmar Contraseña
                </label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" id="inputConfirmPassword" class="form-control" placeholder="Repite tu contraseña" required />
                    <button class="btn btn-outline-secondary toggle-password-btn" type="button" onclick="togglePasswordVisibility('inputConfirmPassword', 'eyeIcon2')">
                        <i class="bi bi-eye" id="eyeIcon2"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Botón de Registro -->
            <button type="submit" class="btn btn-register-tenant w-100 fs-6 shadow-sm">
                <i class="bi bi-person-check-fill me-1"></i> Completar Registro en @nombreNegocio
            </button>
        </form>

        <!-- Enlace a Login y pie -->
        <div class="text-center mt-4 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
            <p class="text-secondary small mb-2">
                ¿Ya tienes cuenta registrada?
                <a asp-controller="Account" asp-action="Login" class="fw-semibold text-decoration-none" style="color: var(--tenant-secondary);">
                    Inicia sesión aquí
                </a>
            </p>
            <span class="text-secondary" style="font-size: 0.72rem;">&copy; 2026 @nombreNegocio &bull; Potenciado por SaaS Barbería</span>
        </div>
    </div>

    <script>
        function togglePasswordVisibility(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>

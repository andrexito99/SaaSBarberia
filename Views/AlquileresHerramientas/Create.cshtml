@model SaaSBarberia.Models.AlquilerHerramienta

@{
    ViewData["Title"] = "Nuevo Alquiler";
}

<h1>Registrar Préstamo de Equipo</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Seleccionar Herramienta Disponible</label>
                <select asp-for="HerramientaId" class="form-select" asp-items="ViewBag.HerramientaId">
                    <option value="">-- Seleccione una máquina --</option>
                </select>
                <span asp-validation-for="HerramientaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Barbero Responsable</label>
                <select asp-for="BarberoId" class="form-select" asp-items="ViewBag.BarberoId">
                    <option value="">-- Seleccione el barbero --</option>
                </select>
                <span asp-validation-for="BarberoId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaPrestamo" class="control-label">Fecha de Préstamo</label>
                <input asp-for="FechaPrestamo" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="FechaPrestamo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CostoAlquiler" class="control-label">Costo del Alquiler ($)</label>
                <input asp-for="CostoAlquiler" class="form-control" type="number" step="0.01" value="0.00" />
                <span asp-validation-for="CostoAlquiler" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Confirmar Préstamo" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Regresar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
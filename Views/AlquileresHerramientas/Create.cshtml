@model SaaSBarberia.Models.AlquilerHerramienta

@{
    ViewData["Title"] = "Nuevo Préstamo de Equipo";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-warning"></i> Registrar Préstamo / Alquiler
            </h2>
            <p class="text-secondary small mb-0 mt-1">Asigna una máquina disponible del inventario a un barbero responsable</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a préstamos
        </a>
    </div>

    <div class="card p-4 p-md-5">
        <form asp-action="Create" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3"></div>

            <!-- Selección de Herramienta Disponible -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0">
                        <i class="bi bi-tools text-warning me-1"></i> Seleccionar Herramienta Disponible *
                    </label>
                    <a asp-controller="Herramientas" asp-action="Create" class="small text-warning text-decoration-none">
                        <i class="bi bi-plus-circle me-1"></i>+ Nueva Máquina
                    </a>
                </div>
                <select asp-for="HerramientaId" class="form-select" asp-items="ViewBag.HerramientaId" required>
                    <option value="">-- Seleccione una máquina disponible --</option>
                </select>
                <span asp-validation-for="HerramientaId" class="text-danger small"></span>
                <small class="text-secondary d-block mt-1">Solo se listan los equipos con estado <strong>"Disponible"</strong> de tu sede.</small>
            </div>

            <!-- Barbero Responsable -->
            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-person-fill text-warning me-1"></i> Barbero Responsable *
                </label>
                <select asp-for="BarberoId" class="form-select" asp-items="ViewBag.BarberoId" required>
                    <option value="">-- Seleccione el colaborador --</option>
                </select>
                <span asp-validation-for="BarberoId" class="text-danger small"></span>
            </div>

            <!-- Fecha de Préstamo -->
            <div class="mb-3">
                <label asp-for="FechaPrestamo" class="form-label">
                    <i class="bi bi-calendar-event text-warning me-1"></i> Fecha y Hora de Entrega
                </label>
                <input asp-for="FechaPrestamo" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                <span asp-validation-for="FechaPrestamo" class="text-danger small"></span>
            </div>

            <!-- Tarifa / Costo Alquiler -->
            <div class="mb-4">
                <label asp-for="CostoAlquiler" class="form-label">
                    <i class="bi bi-currency-dollar text-warning me-1"></i> Tarifa de Alquiler / Canon ($)
                </label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostoAlquiler" class="form-control" type="number" step="0.01" value="0.00" required />
                </div>
                <span asp-validation-for="CostoAlquiler" class="text-danger small"></span>
                <small class="text-secondary d-block mt-1">Monto acordado por el uso del equipo durante la jornada.</small>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-check-lg me-1"></i> Confirmar Préstamo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
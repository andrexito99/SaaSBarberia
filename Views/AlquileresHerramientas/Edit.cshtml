@model SaaSBarberia.Models.AlquilerHerramienta

@{
    ViewData["Title"] = "Actualizar Alquiler";
}

<h1>Registrar Devolución o Editar Préstamo</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label class="control-label">Herramienta</label>
                <select asp-for="HerramientaId" class="form-select" asp-items="ViewBag.HerramientaId"></select>
                <span asp-validation-for="HerramientaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Barbero</label>
                <select asp-for="BarberoId" class="form-select" asp-items="ViewBag.BarberoId"></select>
                <span asp-validation-for="BarberoId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaPrestamo" class="control-label">Fecha de Préstamo</label>
                <input asp-for="FechaPrestamo" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaPrestamo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaDevolucion" class="control-label">Fecha de Devolución (Llenar para liberar equipo)</label>
                <input asp-for="FechaDevolucion" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaDevolucion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CostoAlquiler" class="control-label">Costo Total ($)</label>
                <input asp-for="CostoAlquiler" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CostoAlquiler" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar Cambios" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
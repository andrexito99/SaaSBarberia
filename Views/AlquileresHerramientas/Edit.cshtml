@model SaaSBarberia.Models.AlquilerHerramienta

@{
    ViewData["Title"] = "Actualizar Préstamo";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-arrow-return-left text-warning"></i> Registrar Devolución o Editar Préstamo
            </h2>
            <p class="text-secondary small mb-0 mt-1">Completa la fecha de devolución para liberar la máquina y marcarla como "Disponible".</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>

    <div class="card p-4 p-md-5">
        <form asp-action="Edit" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <!-- Máquina -->
            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-tools text-warning me-1"></i> Herramienta Asignada
                </label>
                <select asp-for="HerramientaId" class="form-select" asp-items="ViewBag.HerramientaId"></select>
                <span asp-validation-for="HerramientaId" class="text-danger small"></span>
            </div>

            <!-- Barbero -->
            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-person-fill text-warning me-1"></i> Barbero Responsable
                </label>
                <select asp-for="BarberoId" class="form-select" asp-items="ViewBag.BarberoId"></select>
                <span asp-validation-for="BarberoId" class="text-danger small"></span>
            </div>

            <!-- Fecha de Préstamo -->
            <div class="mb-3">
                <label asp-for="FechaPrestamo" class="form-label">
                    <i class="bi bi-calendar-event text-warning me-1"></i> Fecha de Entrega
                </label>
                <input asp-for="FechaPrestamo" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaPrestamo" class="text-danger small"></span>
            </div>

            <!-- Fecha de Devolución -->
            <div class="mb-3">
                <label asp-for="FechaDevolucion" class="form-label text-success fw-bold">
                    <i class="bi bi-calendar2-check-fill text-success me-1"></i> Fecha de Devolución
                </label>
                <input asp-for="FechaDevolucion" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaDevolucion" class="text-danger small"></span>
                <small class="text-secondary d-block mt-1">Al ingresar la fecha de entrega, el sistema reintegrará la máquina como <strong>Disponible</strong>.</small>
            </div>

            <!-- Costo del Alquiler -->
            <div class="mb-4">
                <label asp-for="CostoAlquiler" class="form-label">
                    <i class="bi bi-currency-dollar text-warning me-1"></i> Canon Total Liquidado ($)
                </label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostoAlquiler" class="form-control" type="number" step="0.01" />
                </div>
                <span asp-validation-for="CostoAlquiler" class="text-danger small"></span>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-check-lg me-1"></i> Guardar y Procesar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
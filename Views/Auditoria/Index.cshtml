@model IEnumerable<SaaSBarberia.Models.Auditoria>

@{
    ViewData["Title"] = "Historial de Auditoría Global";
    var listaUsuarios = ViewBag.ListaUsuarios as Dictionary<int, string> ?? new Dictionary<int, string>();
    var listaTenants = ViewBag.ListaTenants as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container-fluid mt-4" data-listing>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-shield-lock-fill text-danger"></i> Historial de Auditoría General</h2>
        <span class="badge bg-dark text-white">Modo SuperAdmin</span>
    </div>

    <!-- 🎯 PANEL DE FILTROS BUSCADORES -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Filtrar por Barbería (Tenant)</label>
                    <select name="tenantId" class="form-select" asp-items="ViewBag.TenantId">
                        <option value="">-- Todas las Sedes --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Módulo / Entidad</label>
                    <select name="entidad" class="form-select" asp-items="ViewBag.Entidades">
                        <option value="">-- Todas las Entidades --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Acción Realizada</label>
                    <select name="accion" class="form-select" asp-items="ViewBag.Acciones">
                        <option value="">-- Todas las Acciones --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filtrar</button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- 📊 TABLA DE MOVIMIENTOS -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-white">
                    <tr>
                        <th style="width: 15%;">Fecha y Hora</th>
                        <th style="width: 15%;">Sede (Tenant)</th>
                        <th style="width: 12%;">Usuario</th>
                        <th style="width: 10%;">Entidad</th>
                        <th style="width: 12%;">Acción</th>
                        <th style="width: 28%;">Descripción del Movimiento</th>
                        <th style="width: 8%;">IP Origen</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No se encontraron registros de auditoría con los filtros seleccionados.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            string badgeClass = item.Accion.Contains("Fallo") || item.Accion.Contains("Eliminar") ? "bg-danger" :
                                                item.Accion.Contains("Crear") || item.Accion.Contains("Abrir") ? "bg-success" :
                                                item.Accion.Contains("Editar") ? "bg-warning text-dark" : "bg-info text-dark";

                            // Buscamos los nombres de forma segura en los diccionarios
                            string nombreTenant = listaTenants.ContainsKey(item.TenantId) ? listaTenants[item.TenantId] : "Sede Desconocida";
                            string nombreUsuario = item.UsuarioId.HasValue && listaUsuarios.ContainsKey(item.UsuarioId.Value) ? listaUsuarios[item.UsuarioId.Value] : "Sistema / Anónimo";

                            <tr>
                                <td class="fw-bold text-secondary">
                                    @item.Fecha.ToString("dd/MM/yyyy hh:mm:ss tt")
                                </td>
                                <td>
                                    <span class="text-dark fw-bold">@nombreTenant</span>
                                    <br /><small class="text-muted text-uppercase" style="font-size: 10px;">ID Tenant: @item.TenantId</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@nombreUsuario</span>
                                    <br /><small class="text-muted" style="font-size: 11px;">ID Usr: @(item.UsuarioId?.ToString() ?? "N/A")</small>
                                </td>
                                <td>
                                    <span class="fw-bold">@item.Entidad</span>
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@item.Accion</span>
                                </td>
                                <td>
                                    <div class="text-wrap" style="max-width: 400px; font-size: 13px;">
                                        @item.Descripcion
                                    </div>
                                    @if (item.RegistroId != "0" && !string.IsNullOrEmpty(item.RegistroId))
                                    {
                                        <small class="text-muted d-block" style="font-size: 10px;">ID Registro Afectado: @item.RegistroId</small>
                                    }
                                </td>
                                <td>
                                    <code class="text-dark bg-light px-2 py-1 rounded" style="font-size: 12px;">@(string.IsNullOrEmpty(item.DireccionIP) ? "127.0.0.1" : item.DireccionIP)</code>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

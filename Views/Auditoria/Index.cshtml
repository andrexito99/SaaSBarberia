@model IEnumerable<SaaSBarberia.Models.Auditoria>

@{
    ViewData["Title"] = "Historial de Auditoría Global";
    var listaUsuarios = ViewBag.ListaUsuarios as Dictionary<int, string> ?? new Dictionary<int, string>();
    var listaTenants = ViewBag.ListaTenants as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container-fluid mt-4" data-listing>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-shield-shaded text-danger"></i> Historial de Auditoría General
            </h2>
            <p class="text-secondary small mb-0 mt-1">Monitoreo y trazabilidad forense de operaciones en la base de datos</p>
        </div>
        <span class="badge bg-secondary px-3 py-2 fs-7">
            <i class="bi bi-lock-fill text-warning me-1"></i> Modo SuperAdmin
        </span>
    </div>

    <!-- 🎯 PANEL DE FILTROS BUSCADORES -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Filtrar por Barbería (Tenant)</label>
                    <select name="tenantId" class="form-select" asp-items="ViewBag.TenantId">
                        <option value="">-- Todas las Sedes --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Módulo / Entidad</label>
                    <select name="entidad" class="form-select" asp-items="ViewBag.Entidades">
                        <option value="">-- Todas las Entidades --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Acción Realizada</label>
                    <select name="accion" class="form-select" asp-items="ViewBag.Acciones">
                        <option value="">-- Todas las Acciones --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- 📊 TABLA DE MOVIMIENTOS -->
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 15%;">Fecha y Hora</th>
                        <th style="width: 15%;">Sede (Tenant)</th>
                        <th style="width: 12%;">Usuario</th>
                        <th style="width: 10%;">Entidad</th>
                        <th style="width: 12%;">Acción</th>
                        <th style="width: 28%;">Descripción del Movimiento</th>
                        <th style="width: 8%;">IP Origen</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="empty-state border-0 my-0 py-4">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-search"></i>
                                    </div>
                                    <h5 class="empty-state-title">Sin registros encontrados</h5>
                                    <p class="empty-state-desc">No se encontraron eventos de auditoría con los filtros seleccionados.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            string badgeClass = item.Accion.Contains("Fallo") || item.Accion.Contains("Eliminar") ? "bg-danger" :
                                                item.Accion.Contains("Crear") || item.Accion.Contains("Abrir") ? "bg-success" :
                                                item.Accion.Contains("Editar") ? "bg-warning" : "bg-info";

                            string nombreTenant = listaTenants.ContainsKey(item.TenantId) ? listaTenants[item.TenantId] : "Sede Desconocida";
                            string nombreUsuario = item.UsuarioId.HasValue && listaUsuarios.ContainsKey(item.UsuarioId.Value) ? listaUsuarios[item.UsuarioId.Value] : "Sistema / Anónimo";

                            <tr>
                                <td class="fw-semibold text-secondary">
                                    <i class="bi bi-clock me-1 text-muted"></i>
                                    @item.Fecha.ToString("dd/MM/yyyy hh:mm:ss tt")
                                </td>
                                <td>
                                    <span class="text-white fw-bold">@nombreTenant</span>
                                    <br /><small class="text-secondary text-uppercase" style="font-size: 10px;">ID: @item.TenantId</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-person-fill me-1"></i>@nombreUsuario
                                    </span>
                                    <br /><small class="text-secondary" style="font-size: 11px;">ID: @(item.UsuarioId?.ToString() ?? "N/A")</small>
                                </td>
                                <td>
                                    <span class="fw-semibold text-white">@item.Entidad</span>
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@item.Accion</span>
                                </td>
                                <td>
                                    <div class="text-wrap text-body" style="max-width: 420px; font-size: 13px;">
                                        @item.Descripcion
                                    </div>
                                    @if (item.RegistroId != "0" && !string.IsNullOrEmpty(item.RegistroId))
                                    {
                                        <small class="text-secondary d-block mt-1" style="font-size: 10px;">
                                            <i class="bi bi-tag me-1"></i>Reg ID: @item.RegistroId
                                        </small>
                                    }
                                </td>
                                <td>
                                    <code>@(string.IsNullOrEmpty(item.DireccionIP) ? "127.0.0.1" : item.DireccionIP)</code>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

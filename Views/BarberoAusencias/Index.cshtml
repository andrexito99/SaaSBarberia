@model IEnumerable<SaaSBarberia.Models.BarberoAusencia>

@{
    ViewData["Title"] = "Control de Ausencias";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-calendar-x-fill text-warning"></i> Ausencias e Indisponibilidades
            </h2>
            <p class="text-secondary small mb-0 mt-1">Gestiona los periodos libres, vacaciones y bloqueos de agenda de tu personal.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Programar Ausencia
        </a>
    </div>

    <div class="card" data-listing>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Barbero</th>
                            <th>Tipo</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Motivo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state border-0 my-0 py-3">
                                        <div class="empty-state-icon">
                                            <i class="bi bi-calendar2-check"></i>
                                        </div>
                                        <h5 class="empty-state-title">No hay ausencias programadas</h5>
                                        <p class="empty-state-desc">Todo el personal está disponible en sus turnos regulares de atención.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                string badgeColor = item.Tipo switch
                                {
                                    TipoAusencia.Vacaciones => "bg-danger",
                                    TipoAusencia.Incapacidad => "bg-warning",
                                    TipoAusencia.Permiso => "bg-info",
                                    TipoAusencia.BloqueoTemporal => "bg-secondary",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-3" style="width: 36px; height: 36px; font-size: 0.9rem;">
                                                💈
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-white">@(item.Barbero?.Usuario?.Nombre ?? "Sin Asignar")</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @badgeColor">
                                            @item.Tipo
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-white">@item.FechaInicio.ToString("dd/MM/yyyy")</div>
                                        <small class="text-secondary"><i class="bi bi-clock me-1 text-muted"></i>@item.FechaInicio.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-white">@item.FechaFin.ToString("dd/MM/yyyy")</div>
                                        <small class="text-secondary"><i class="bi bi-clock me-1 text-muted"></i>@item.FechaFin.ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-wrap" style="max-width: 200px;">
                                        <span class="text-white">@item.Motivo</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

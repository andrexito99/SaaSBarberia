@model IEnumerable<SaaSBarberia.Models.BarberoAusencia>

@{
    ViewData["Title"] = "Control de Ausencias";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">🏖️ Ausencias e Indisponibilidades</h2>
            <p class="text-muted mb-0">Gestiona los periodos libres, vacaciones y bloqueos de agenda de tu personal.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4 py-2">
            ➕ Programar Ausencia
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Barbero</th>
                            <th>Tipo</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Motivo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <p class="mb-0 fs-5">No hay ausencias registradas aún.</p>
                                    <small>Usa el botón superior para ingresar la primera.</small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                // 🔥 CORREGIDO: El switch formateado correctamente sin comerse el código con comentarios inline
                                string badgeColor = item.Tipo switch
                                {
                                    TipoAusencia.Vacaciones => "bg-danger",
                                    TipoAusencia.Incapacidad => "bg-warning text-dark",
                                    TipoAusencia.Permiso => "bg-info text-dark",
                                    TipoAusencia.BloqueoTemporal => "bg-secondary",
                                    _ => "bg-dark"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-3 text-primary fw-bold">
                                                💈
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@(item.Barbero?.Usuario?.Nombre ?? "Sin Asignar")</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @badgeColor px-3 py-2 rounded-pill fw-semibold">
                                            @item.Tipo
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.FechaInicio.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">⏱️ @item.FechaInicio.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.FechaFin.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">⏱️ @item.FechaFin.ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-wrap" style="max-width: 200px;">
                                        <span class="text-dark fw-semibold">@item.Motivo</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

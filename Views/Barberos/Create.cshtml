@model SaaSBarberia.Models.Barbero

@{
    ViewData["Title"] = "Nuevo Barbero";
}

<div class="container mt-4" style="max-width: 550px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">Asignar Perfil de Barbero</h3>

        @* 🚨 ENCTYPE AGREGADO: Necesario para procesar la foto en binario *@
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UsuarioId" class="form-label fw-semibold">Seleccionar Usuario Base</label>
                <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId">
                    <option value="">-- Escoger Cuenta de Usuario --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="TenantId" class="form-label fw-semibold">Asignar a Barbería (Sede)</label>
                <select asp-for="TenantId" class="form-select" asp-items="ViewBag.TenantId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Especialidad" class="form-label fw-semibold">Especialidad / Enfoque</label>
                <input asp-for="Especialidad" class="form-control" placeholder="Ej: Degradados, Barboterapia, Clásico" />
                <span asp-validation-for="Especialidad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ComisionPorcentaje" class="form-label fw-semibold">Porcentaje de Comisión (%)</label>
                <input asp-for="ComisionPorcentaje" type="number" step="0.01" class="form-control" placeholder="Ej: 45.00" />
                <span asp-validation-for="ComisionPorcentaje" class="text-danger"></span>
            </div>

            @* 📸 CAMPO PREMIUM: Subida de la foto del Barbero *@
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark">Foto del Barbero</label>
                <input type="file" name="fotoInput" id="fotoInput" class="form-control" accept="image/*" />
                <small class="text-muted">Se almacenará de forma segura en la base de datos.</small>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Regresar</a>
                <button type="submit" class="btn btn-primary px-4">Vincular Barbero</button>
            </div>
        </form>
    </div>
</div>
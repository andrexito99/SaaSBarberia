@model SaaSBarberia.Models.Barbero

@{
    ViewData["Title"] = "Modificar Barbero";
}

<div class="container mt-4" style="max-width: 550px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">Editar Condiciones del Barbero</h3>

        @* 🚨 ENCTYPE CONFIGURADO CORRECTAMENTE *@
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            @* 📸 Renderizado de la foto actual antes de cambiarla *@
            <div class="text-center mb-4">
                @if (Model.Foto != null && Model.Foto.Length > 0)
                {
                    var base64 = Convert.ToBase64String(Model.Foto);
                    var imgSrc = $"data:image/png;base64,{base64}";
                    <img src="@imgSrc" class="rounded-circle border shadow" style="width: 100px; height: 100px; object-fit: cover;" alt="Foto Actual" />
                }
                else
                {
                    <div class="mx-auto bg-dark text-white rounded-circle p-3 mb-2 shadow" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                        💈
                    </div>
                }
                <small class="text-muted d-block mt-2">Foto Actual del Perfil</small>
            </div>

            <div class="mb-3">
                <label asp-for="UsuarioId" class="form-label fw-semibold">Cuenta de Usuario Vinculada</label>
                <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="TenantId" class="form-label fw-semibold">Lugar de Trabajo (Sede)</label>
                <select asp-for="TenantId" class="form-select" asp-items="ViewBag.TenantId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Especialidad" class="form-label fw-semibold">Especialidad</label>
                <input asp-for="Especialidad" class="form-control" />
                <span asp-validation-for="Especialidad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ComisionPorcentaje" class="form-label fw-semibold">Porcentaje de Comisión</label>
                <input asp-for="ComisionPorcentaje" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="ComisionPorcentaje" class="text-danger"></span>
            </div>

            @* 📸 CAMPO DE ACTUALIZACIÓN DE FOTO: Conecta directo con el parámetro del controlador *@
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark">Cambiar Foto de Perfil</label>
                <input type="file" name="fotoInput" id="fotoInput" class="form-control" accept="image/*" />
                <small class="text-muted">Deja este campo vacío si deseas mantener la foto actual.</small>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-warning px-4 fw-bold">Actualizar Contrato</button>
            </div>
        </form>
    </div>
</div>
@model IEnumerable<SaaSBarberia.Models.Barbero>

@{
    ViewData["Title"] = "Staff de Barberos";
}

<div class="container mt-4" data-listing>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white fw-bold m-0 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-warning"></i> Equipo de Barberos
            </h2>
            <p class="text-secondary small mb-0 mt-1">Colaboradores, perfiles profesionales y porcentajes de comisión</p>
        </div>

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus-fill"></i> Dar de Alta Barbero
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h4 class="empty-state-title">No hay colaboradores registrados</h4>
            <p class="empty-state-desc">Registra los barberos y especialistas de tu staff para habilitar citas.</p>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-lg"></i> Agregar Primer Barbero
                </a>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" data-listing-grid>
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 overflow-hidden">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="me-3">
                                    @if (!string.IsNullOrEmpty(item.RutaFoto))
                                    {
                                        <img src="@item.RutaFoto" class="rounded-circle shadow-sm" style="width: 56px; height: 56px; object-fit: cover; border: 2px solid var(--saas-gold);" alt="@item.Usuario?.Nombre" />
                                    }
                                    else
                                    {
                                        <div class="kpi-icon-wrapper kpi-icon-amber" style="width: 56px; height: 56px; font-size: 1.4rem;">
                                            💈
                                        </div>
                                    }
                                </div>
                                <div class="overflow-hidden">
                                    <h5 class="card-title fw-bold mb-0 text-truncate text-white">@(item.Usuario?.Nombre ?? "Sin Nombre")</h5>
                                    <small class="text-warning fw-semibold d-block text-truncate">🎯 @(item.Especialidad ?? "Estilo Libre")</small>
                                </div>
                            </div>

                            <hr />

                            <div class="small mb-3">
                                <p class="mb-1 text-secondary">
                                    <i class="bi bi-cash-coin me-2 text-warning"></i><span>Comisión:</span> 
                                    <strong class="text-white">@(item.ComisionPorcentaje?.ToString("0") ?? "0")% por corte</strong>
                                </p>
                                <p class="mb-1 text-secondary text-truncate">
                                    <i class="bi bi-envelope me-2 text-info"></i><span>Contacto:</span> 
                                    <span class="text-white">@(item.Usuario?.Email ?? "No asignado")</span>
                                </p>
                                <p class="mb-0 text-secondary text-truncate">
                                    <i class="bi bi-shop me-2 text-success"></i><span>Sede:</span> 
                                    <span class="text-white fw-semibold">@(item.Tenant?.NombreNegocio ?? "Sede Desconocida")</span>
                                </p>
                            </div>
                        </div>

                        <div class="card-footer d-flex gap-2">
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-fill">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info flex-fill">
                                    <i class="bi bi-eye me-1"></i>Detalles
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger flex-fill">
                                    <i class="bi bi-trash me-1"></i>Borrar
                                </a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-100">
                                    <i class="bi bi-eye me-1"></i>Ver Perfil
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@model SaaSBarberia.Models.Cita

@{
    ViewData["Title"] = "Remover Cita";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow border-0 p-4 border-top border-danger border-4 text-center">
        <h3 class="text-danger fw-bold">⚠ ¿Cancelar esta cita definitivamente?</h3>
        <p class="text-muted">Se eliminará de la agenda el espacio reservado para el cliente <strong>@(Model.Cliente?.Nombre ?? "Asignado")</strong> el día <strong>@Model.FechaHora.ToString("dd/MM/yyyy")</strong>.</p>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Mantener cupo</a>
                <input type="submit" value="Sí, cancelar turno" class="btn btn-danger px-4" />
            </div>
        </form>
    </div>
</div>
@using System.Security.Claims
@model IEnumerable<SaaSBarberia.Models.Cita>

@{
    ViewData["Title"] = "Agenda de Citas";
    var usuarioActualId = int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var usuarioId) ? usuarioId : 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-calendar-event text-warning"></i> Agenda de Citas
            </h2>
            <p class="text-secondary small mb-0 mt-1">Control de turnos, horarios y estados de atención</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Agendar Nueva Cita
        </a>
    </div>

    <div class="card p-3" data-listing>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Barbería</th>
                        <th>Barbero</th>
                        <th>Servicio</th>
                        <th>Fecha y Hora</th>
                        <th>Estado</th>
                        @if (User.IsInRole("Cliente"))
                        {
                            <th class="text-center">Gestión</th>
                        }
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador") || User.IsInRole("Barbero"))
                        {
                            <th class="text-center">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="empty-state border-0 my-0 py-3">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-calendar-x"></i>
                                    </div>
                                    <h5 class="empty-state-title">No hay citas agendadas</h5>
                                    <p class="empty-state-desc">Actualmente no existen turnos programados en el calendario.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-white">@item.Cliente?.Nombre</td>
                                <td>@item.Tenant?.NombreNegocio</td>

                                <td>
                                    @if (item.Barbero?.Usuario != null)
                                    {
                                        <span class="fw-semibold text-white">
                                            <i class="bi bi-person-badge text-warning me-1"></i>@item.Barbero.Usuario.Nombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">No asignado</span>
                                    }
                                </td>

                                <td class="text-white">@item.Servicio?.Nombre</td>
                                <td class="text-secondary">
                                    <i class="bi bi-clock me-1 text-muted"></i>@item.FechaHora.ToString("dd/MM/yyyy hh:mm tt")
                                </td>
                                <td>
                                    @if (item.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning">
                                            <i class="bi bi-hourglass-split"></i> Pendiente
                                        </span>
                                    }
                                    else if (item.Estado == "Completada")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill"></i> Completada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle-fill"></i> Cancelada
                                        </span>
                                    }
                                </td>

                                @* 🌟 BOTÓN DE AUTOGESTIÓN PARA CLIENTES *@
                                @if (User.IsInRole("Cliente"))
                                {
                                    <td class="text-center">
                                        @if (item.Estado == "Pendiente")
                                        {
                                            <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Está seguro de cancelar esta cita agendada?');" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-lg"></i> Cancelar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">-</span>
                                        }
                                    </td>
                                }

                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador") || User.IsInRole("Barbero"))
                                {
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            @if (User.IsInRole("Barbero") && item.Barbero?.UsuarioId == usuarioActualId && item.Estado == "Pendiente")
                                            {
                                                <form asp-action="Completar" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Completar cita">
                                                        <i class="bi bi-check2"></i> Completar
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

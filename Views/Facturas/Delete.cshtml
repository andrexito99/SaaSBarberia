@model SaaSBarberia.Models.Factura

@{
    ViewData["Title"] = "Anular Factura";
}

<div class="container mt-4" style="max-width: 450px;">
    <div class="card shadow border-0 p-4 border-top border-danger border-4 text-center">
        <h4 class="text-danger fw-bold">⚠️ ¿Anular esta transacción de caja?</h4>
        <p class="text-muted mt-2">Vas a eliminar el comprobante de pago <strong>#@Model.Id</strong> por un valor de <strong>@Model.Total.ToString("C0")</strong>. Esto afectará los cierres de caja.</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Mantener válida</a>
                <input type="submit" value="Sí, anular transacción" class="btn btn-danger px-4" />
            </div>
        </form>
    </div>
</div>
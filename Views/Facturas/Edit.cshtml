@model SaaSBarberia.Models.Factura

@{
    ViewData["Title"] = "Editar Factura";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">✏️ Modificar Registro de Pago</h3>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="TenantId" class="form-label fw-semibold">Sucursal</label>
                <select asp-for="TenantId" class="form-select" asp-items="ViewBag.TenantId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="CitaId" class="form-label fw-semibold">Cita Vinculada</label>
                <select asp-for="CitaId" class="form-select" asp-items="ViewBag.CitaId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Total" class="form-label fw-semibold">Valor Total ($)</label>
                <input asp-for="Total" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MetodoPago" class="form-label fw-semibold">Forma de Pago</label>
                <select asp-for="MetodoPago" class="form-select">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta">Tarjeta de Crédito/Débito</option>
                    <option value="Transferencia">Transferencia / Nequi / Daviplata</option>
                </select>
                <span asp-validation-for="MetodoPago" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPago" class="form-label fw-semibold">Fecha</label>
                <input asp-for="FechaPago" class="form-control" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-warning px-4">Actualizar Transacción</button>
            </div>
        </form>
    </div>
</div>
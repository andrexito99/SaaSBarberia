@model IEnumerable<SaaSBarberia.Models.Factura>

@{
    ViewData["Title"] = "Historial de Facturación";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white fw-bold m-0 d-flex align-items-center gap-2">
                <i class="bi bi-receipt text-warning"></i> Registro de Facturas
            </h2>
            <p class="text-secondary small mb-0 mt-1">Histórico de comprobantes emitidos, cobros y métodos de pago</p>
        </div>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-currency-dollar"></i> Registrar Pago
            </a>
        }
    </div>

    <div class="card" data-listing>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Factura ID</th>
                        <th>Sucursal / Tenant</th>
                        <th>Cita N°</th>
                        <th>Método de Pago</th>
                        <th>Fecha de Pago</th>
                        <th>Total Cobrado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="empty-state border-0 my-0 py-3">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-receipt-cutoff"></i>
                                    </div>
                                    <h5 class="empty-state-title">No hay facturas registradas</h5>
                                    <p class="empty-state-desc">A medida que se procesen cobros, aparecerá aquí el registro financiero detallado.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-white">#@item.Id</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-shop me-1"></i>@(item.Tenant?.NombreNegocio ?? "Global")
                                    </span>
                                </td>
                                <td class="text-secondary">Cita #@item.CitaId</td>
                                <td>
                                    <span class="badge @(item.MetodoPago == "Efectivo" ? "bg-success" : "bg-info")">
                                        <i class="bi @(item.MetodoPago == "Efectivo" ? "bi-cash" : "bi-credit-card") me-1"></i>@item.MetodoPago
                                    </span>
                                </td>
                                <td class="text-secondary">
                                    <i class="bi bi-clock me-1 text-muted"></i>@(item.FechaPago?.ToString("dd/MM/yyyy hh:mm tt") ?? "Pendiente")
                                </td>
                                <td class="fw-bold text-success fs-6">$@item.Total.ToString("N0")</td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver Recibo">
                                            <i class="bi bi-receipt me-1"></i>Recibo
                                        </a>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Anular">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

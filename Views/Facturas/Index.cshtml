@model IEnumerable<SaaSBarberia.Models.Factura>

@{
    ViewData["Title"] = "Historial de Facturación";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">🧾 Registro de Facturas</h2>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-success px-4 shadow-sm">💵 Registrar Pago</a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Factura ID</th>
                        <th>Sucursal / Tenant</th>
                        <th>Cita N°</th>
                        <th>Método de Pago</th>
                        <th>Fecha de Pago</th>
                        <th>Total Cobrado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-secondary">#@item.Id</td>
                            <td><span class="badge bg-light text-dark border">@(item.Tenant?.NombreNegocio ?? "Global")</span></td>
                            <td>Cita #@item.CitaId</td>
                            <td>
                                <span class="badge @(item.MetodoPago == "Efectivo" ? "bg-info" : "bg-primary") px-2.5 py-1.5">
                                    💳 @item.MetodoPago
                                </span>
                            </td>
                            <td>@(item.FechaPago?.ToString("dd/MM/yyyy hh:mm tt") ?? "Pendiente")</td>
                            @* 🇨🇴 CAMBIO AQUÍ: Formato forzado a Pesos Colombianos *@
                            <td class="fw-bold text-success fs-6">$@item.Total.ToString("N0")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Ver Recibo</a>
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Anular</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
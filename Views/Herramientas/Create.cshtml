@model SaaSBarberia.Models.Herramienta

@{
    ViewData["Title"] = "Agregar Herramienta";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill text-warning"></i> Registrar Nueva Herramienta
            </h2>
            <p class="text-secondary small mb-0 mt-1">Añade máquinas, clippers o herramientas al inventario de tu sede</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>

    <div class="card p-4 p-md-5">
        <form asp-action="Create" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3"></div>

            <!-- Nombre -->
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">
                    <i class="bi bi-tag-fill me-1 text-warning"></i> Nombre del Equipo *
                </label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Patillera Wahl Detailer Li" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <!-- Marca -->
            <div class="mb-3">
                <label asp-for="Marca" class="form-label">
                    <i class="bi bi-award me-1 text-warning"></i> Marca / Fabricante
                </label>
                <input asp-for="Marca" class="form-control" placeholder="Ej. Wahl, Babyliss Pro, Andis, Gamma+" />
                <span asp-validation-for="Marca" class="text-danger small"></span>
            </div>

            <!-- Número de Serie -->
            <div class="mb-3">
                <label asp-for="NumeroSerie" class="form-label">
                    <i class="bi bi-upc-scan me-1 text-warning"></i> Número de Serie o Código Interno
                </label>
                <input asp-for="NumeroSerie" class="form-control" placeholder="Ej. SN-2026-WL-001" />
                <span asp-validation-for="NumeroSerie" class="text-danger small"></span>
                <small class="text-secondary d-block mt-1">Identificador único para control en préstamos a barberos.</small>
            </div>

            <!-- Estado Inicial -->
            <div class="mb-4">
                <label asp-for="Estado" class="form-label">
                    <i class="bi bi-toggles me-1 text-warning"></i> Estado Inicial
                </label>
                <select asp-for="Estado" class="form-select">
                    <option value="Disponible">🟢 Disponible (Para Alquiler)</option>
                    <option value="Alquilado">🔵 Alquilado (En uso)</option>
                    <option value="Mantenimiento">🟡 En Mantenimiento</option>
                    <option value="Dañado">🔴 Dañado / Fuera de Servicio</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-check-lg me-1"></i> Guardar en Inventario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
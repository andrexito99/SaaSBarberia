@model SaaSBarberia.Models.Herramienta

@{
    ViewData["Title"] = "Eliminar Herramienta";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-trash-fill text-danger"></i> Eliminar Herramienta
            </h2>
            <p class="text-secondary small mb-0 mt-1">Confirmación de baja de equipo del inventario</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Cancelar
        </a>
    </div>

    <div class="card p-4 p-md-5">
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <strong>¿Estás seguro de eliminar esta herramienta?</strong>
                <div class="small">Esta acción removerá el registro del inventario de forma permanente.</div>
            </div>
        </div>

        <div class="p-3 rounded-3 mb-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="avatar-circle" style="width: 48px; height: 48px; font-size: 1.3rem;">
                    ⚙️
                </div>
                <div>
                    <h4 class="fw-bold text-white mb-0">@Model.Nombre</h4>
                    <span class="text-secondary small">Marca: @(string.IsNullOrEmpty(Model.Marca) ? "General" : Model.Marca)</span>
                </div>
            </div>

            <div class="row g-2 small">
                <div class="col-6">
                    <span class="text-secondary d-block">Número de Serie:</span>
                    <span class="text-white">@(string.IsNullOrEmpty(Model.NumeroSerie) ? "Sin serial" : Model.NumeroSerie)</span>
                </div>
                <div class="col-6">
                    <span class="text-secondary d-block">Estado Actual:</span>
                    <span class="text-warning fw-semibold">@Model.Estado</span>
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger fw-bold px-4">
                    <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                </button>
            </div>
        </form>
    </div>
</div>

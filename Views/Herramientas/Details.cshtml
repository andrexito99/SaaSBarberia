@model SaaSBarberia.Models.Herramienta

@{
    ViewData["Title"] = "Ficha de Herramienta";
    string badgeClass = Model.Estado switch
    {
        "Disponible" => "bg-success",
        "Alquilado" => "bg-info",
        "Mantenimiento" => "bg-warning",
        "Dañado" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-warning"></i> Ficha Técnica de Herramienta
            </h2>
            <p class="text-secondary small mb-0 mt-1">Detalles de la máquina y estado operativo actual</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al inventario
        </a>
    </div>

    <div class="card p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="avatar-circle" style="width: 56px; height: 56px; font-size: 1.5rem;">
                💈
            </div>
            <div>
                <h3 class="fw-bold text-white mb-1">@Model.Nombre</h3>
                <span class="badge @badgeClass">
                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@Model.Estado
                </span>
            </div>
        </div>

        <hr class="mb-4" />

        <div class="row g-3">
            <div class="col-sm-6">
                <label class="text-secondary small d-block">Marca / Fabricante:</label>
                <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.Marca) ? "Sin marca registrada" : Model.Marca)</span>
            </div>
            <div class="col-sm-6">
                <label class="text-secondary small d-block">Número de Serie / Código:</label>
                @if (!string.IsNullOrEmpty(Model.NumeroSerie))
                {
                    <code>@Model.NumeroSerie</code>
                }
                else
                {
                    <span class="text-secondary small">No asignado</span>
                }
            </div>
            <div class="col-sm-6">
                <label class="text-secondary small d-block">Identificador Interno:</label>
                <span class="text-white">Equipo #@Model.Id</span>
            </div>
            <div class="col-sm-6">
                <label class="text-secondary small d-block">Sede / Tenant ID:</label>
                <span class="text-white">@(Model.Tenant?.NombreNegocio ?? $"Sede #{Model.TenantId}")</span>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Eliminar
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
</div>

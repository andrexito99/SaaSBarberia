@model IEnumerable<SaaSBarberia.Models.Herramienta>

@{
    ViewData["Title"] = "Inventario de Herramientas";
}

<h1>Gestión de Herramientas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar Nueva Herramienta</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Marca)</th>
            <th>Número de Serie</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(model => item.Nombre)</td>
            <td>@Html.DisplayFor(model => item.Marca)</td>
            <td>@Html.DisplayFor(model => item.NumeroSerie)</td>
            <td>
                <span class="badge @(item.Estado == "Disponible" ? "bg-success" : item.Estado == "Alquilado" ? "bg-warning" : "bg-danger")">
                    @Html.DisplayFor(model => item.Estado)
                </span>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
@model SaaSBarberia.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Administración de Sede";
}

<div class="container-fluid my-4 px-4">
    <!-- Header Banner -->
    <div class="card p-4 mb-4 d-flex flex-row justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2 text-warning"></i> Panel de Administración
            </h2>
            <p class="text-secondary mb-0 small">Control operativo y financiero en tiempo real exclusivo para tu sucursal.</p>
        </div>
        <div class="badge bg-secondary p-2 px-3 fs-7">
            <i class="bi bi-calendar3 me-2 text-warning"></i>@DateTime.Now.ToString("dd MMMM yyyy")
        </div>
    </div>

    <!-- ⚡ ACTIVIDAD DE HOY (KPIS REDISEÑADOS) -->
    <h4 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-lightning-charge-fill text-warning"></i> Actividad de Hoy
    </h4>
    <div class="row g-3 mb-4">
        <!-- Ventas Hoy -->
        <div class="col-6 col-lg-3">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Ventas Hoy</span>
                    <div class="kpi-icon-wrapper kpi-icon-amber">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
                <div class="kpi-value">$@Model.IngresosHoy.ToString("N0")</div>
                <div class="kpi-subtitle">
                    <span class="text-secondary">Caja generada hoy</span>
                </div>
            </div>
        </div>

        <!-- Clientes Atendidos -->
        <div class="col-6 col-lg-3">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Atendidos</span>
                    <div class="kpi-icon-wrapper kpi-icon-emerald">
                        <i class="bi bi-scissors"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.ClientesAtendidosHoy</div>
                <div class="kpi-subtitle">
                    <span class="text-success"><i class="bi bi-check2-all me-1"></i>Cortes completados</span>
                </div>
            </div>
        </div>

        <!-- Citas Pendientes -->
        <div class="col-6 col-lg-3">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Citas Pendientes</span>
                    <div class="kpi-icon-wrapper kpi-icon-blue">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.CitasPendientesHoy</div>
                <div class="kpi-subtitle">
                    <span class="text-secondary">Por atender en la jornada</span>
                </div>
            </div>
        </div>

        <!-- Citas Canceladas -->
        <div class="col-6 col-lg-3">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Citas Canceladas</span>
                    <div class="kpi-icon-wrapper kpi-icon-rose">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.CitasCanceladasHoy</div>
                <div class="kpi-subtitle">
                    <span class="text-secondary">Turnos cancelados hoy</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 RENDIMIENTO DEL MES -->
    <h4 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-graph-up-arrow text-info"></i> Rendimiento del Mes
    </h4>
    <div class="row g-4 mb-4">
        <!-- Ingresos Mensuales -->
        <div class="col-12 col-md-5">
            <div class="card p-4 h-100">
                <span class="text-secondary text-uppercase small fw-bold">Ingresos Acumulados Mes</span>
                <div class="kpi-value my-2">$@Model.IngresosMes.ToString("N0")</div>
                <div class="d-flex align-items-center mt-2">
                    <span class="badge @(Model.EsIngresoMayorMesAnterior ? "bg-success" : "bg-danger") me-2">
                        <i class="bi @(Model.EsIngresoMayorMesAnterior ? "bi-arrow-up" : "bi-arrow-down") me-1"></i>
                        @Math.Abs(Model.PorcentajeComparacionMesAnterior).ToString("N1")%
                    </span>
                    <span class="text-secondary small">vs mes anterior</span>
                </div>
            </div>
        </div>

        <!-- Líderes de Sede -->
        <div class="col-12 col-md-7">
            <div class="card p-4 h-100">
                <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-trophy-fill text-warning"></i> Cuadro de Honor Sede
                </h5>
                <div class="row g-3 text-center">
                    <div class="col-6 col-sm-4 border-end" style="border-color: rgba(255,255,255,0.08) !important;">
                        <p class="text-secondary small mb-1">Servicio Top</p>
                        <h6 class="fw-bold text-white text-truncate px-1">@Model.ServicioMasVendido</h6>
                        <span class="badge bg-info">@Model.CantidadServicioMasVendido cortes</span>
                    </div>
                    <div class="col-6 col-sm-4 border-end" style="border-color: rgba(255,255,255,0.08) !important;">
                        <p class="text-secondary small mb-1">Barbero Estrella</p>
                        <h6 class="fw-bold text-white text-truncate px-1">@Model.BarberoEstrella</h6>
                        <span class="badge bg-success">$@Model.GananciaBarberoEstrella.ToString("N0")</span>
                    </div>
                    <div class="col-12 col-sm-4">
                        <p class="text-secondary small mb-1">Equipo Activo</p>
                        <h6 class="fw-bold text-white">Staff Sede</h6>
                        <span class="badge bg-secondary">@Model.TotalBarberos Barberos</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ⚡ ACCESOS DIRECTOS -->
    <h4 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-grid-fill text-warning"></i> Accesos Directos
    </h4>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card p-3 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <h6 class="fw-bold text-white mb-0">Caja y Facturación</h6>
                    <small class="text-secondary">Movimientos diarios y cierres</small>
                </div>
                <a asp-controller="Caja" asp-action="Index" class="btn btn-sm btn-outline-secondary">Abrir</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <h6 class="fw-bold text-white mb-0">Catálogo de Servicios</h6>
                    <small class="text-secondary">Tarifas y duraciones</small>
                </div>
                <a asp-controller="Servicios" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ajustar</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <h6 class="fw-bold text-white mb-0">Agenda de Citas</h6>
                    <small class="text-secondary">Turnos y calendario de hoy</small>
                </div>
                <a asp-controller="Citas" asp-action="Index" class="btn btn-sm btn-outline-secondary">Monitorear</a>
            </div>
        </div>
    </div>

    <!-- 🏆 TABLA TOP 10 CLIENTES -->
    <div class="card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
            <h4 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-award-fill text-warning"></i> Top 10 Clientes de la Sucursal
            </h4>
            <span class="badge bg-secondary">Por inversión acumulada</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Pos</th>
                        <th>Cliente</th>
                        <th class="text-center">Citas Completadas</th>
                        <th class="text-end">Total Invertido</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Top10Clientes.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="empty-state border-0 my-0 py-3">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <h5 class="empty-state-title">Sin historial de clientes aún</h5>
                                    <p class="empty-state-desc">No se registran facturas pagadas este mes para generar el ranking.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int puesto = 1;
                        foreach (var cliente in Model.Top10Clientes)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(puesto == 1 ? "bg-warning" : puesto == 2 ? "bg-secondary" : puesto == 3 ? "bg-danger" : "bg-dark")" style="width:28px; height:28px; border-radius:50%; justify-content:center; display:inline-flex;">
                                        @puesto
                                    </span>
                                </td>
                                <td class="fw-bold text-white">@cliente.NombreCliente</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@cliente.TotalCitas servicios</span>
                                </td>
                                <td class="text-end fw-bold text-success">$@cliente.TotalGastado.ToString("N0")</td>
                            </tr>
                            puesto++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
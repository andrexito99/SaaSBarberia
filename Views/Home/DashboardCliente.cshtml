@{
    ViewData["Title"] = "Portal de Cliente";
}

<div class="container mt-5 text-center">
    <div class="p-5 bg-white rounded-4 shadow-sm border max-width-600 mx-auto">
        <h2 class="fw-bold text-dark">👋 ¡Hola! Bienvenido a SaaS Barbería</h2>
        <p class="text-muted mt-2">Desde aquí puedes explorar el portafolio y tus citas.</p>
        <div class="mt-4">
            <a asp-controller="Servicios" asp-action="Index" class="btn btn-primary px-4 fw-bold me-2">✂ Ver Catálogo</a>
            <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">📆 Ver Mis Reservas</a>
        </div>
    </div>
</div>
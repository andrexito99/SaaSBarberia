@{
    ViewData["Title"] = "Panel Administrativo y de Trabajo";
}

<div class="container mt-4">
    <div class="alert alert-primary d-flex align-items-center shadow-sm rounded-3 mb-4" role="alert">
        <span class="fs-4 me-3">🔥</span>
        <div>
            <strong>@ViewBag.MensajeHibrido</strong> Tienes acceso total a las finanzas de tu sede y a tu agenda personal.
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    📊 Administración de la Sede
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="text-muted">Como administrador, puedes gestionar las tarifas, ver facturas totales y controlar el personal asignado a esta barbería.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline-dark fw-semibold">💵 Monitorear Caja</a>
                        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-dark fw-semibold">✂ Gestionar Precios y Servicios</a>
                        <a asp-controller="Barberoes" asp-action="Index" class="btn btn-outline-dark fw-semibold">💈 Lista de Empleados</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    📆 Mis Turnos de Hoy
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="text-muted">Revisa las reservas que los clientes han agendado directamente en tu silla para la jornada actual.</p>
                    <div class="d-grid">
                        <a asp-controller="Citas" asp-action="Index" class="btn btn-primary fw-bold shadow-sm">📋 Ver Mi Agenda de Citas</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
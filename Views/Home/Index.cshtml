@model SaaSBarberia.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container mt-4">
    <!-- Banner de Bienvenida Ejecutivo -->
    <div class="card p-4 p-md-5 mb-4 text-center position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, rgba(31, 41, 55, 0.9) 0%, rgba(17, 24, 39, 0.95) 100%) !important;">
        <div class="position-absolute top-0 start-0 w-100 h-100" 
             style="opacity: 0.05; background: radial-gradient(circle at 50% 50%, #F59E0B 0%, transparent 70%); pointer-events: none;"></div>
        <div class="position-relative z-1">
            <span class="badge bg-warning mb-2 px-3 py-1 text-uppercase" style="letter-spacing: 0.1em; font-size: 0.7rem;">SaaS Barbería Core</span>
            <h1 class="display-5 fw-bold text-white mb-2">Panel Operativo y Ejecutivo</h1>
            <p class="fs-6 text-secondary mb-0 max-w-xl mx-auto" style="max-width: 600px;">Administra tus sedes y supervisa la operación.</p>
        </div>
    </div>

    @* 📊 ======================================================== *@
    @* 🌟 SECCIÓN OPERATIVA DEL DASHBOARD PARA ADMINISTRADOR       *@
    @* ========================================================== *@
    @if (User.IsInRole("Administrador") && Model != null)
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h3 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2 text-warning"></i> Operaciones de la Sede
                </h3>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-controller="Tenants" asp-action="DashboardSede" class="btn btn-warning btn-sm fw-bold d-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-qr-code-scan"></i> Panel Sede & Enlace QR
                    </a>
                    <span class="badge bg-success">
                        <i class="bi bi-broadcast me-1"></i> Tiempo Real
                    </span>
                </div>
            </div>

            <!-- ⚡ BLOQUE DE KPIs DE HOY (DARK LUXURY) -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="kpi-card h-100">
                        <div class="kpi-header">
                            <span class="kpi-title">Ventas Hoy</span>
                            <div class="kpi-icon-wrapper kpi-icon-amber">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                        </div>
                        <div class="kpi-value text-white">$@Model.IngresosHoy.ToString("N0")</div>
                        <div class="kpi-subtitle">
                            <span class="text-secondary">Caja generada hoy</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card h-100">
                        <div class="kpi-header">
                            <span class="kpi-title">Atendidos</span>
                            <div class="kpi-icon-wrapper kpi-icon-emerald">
                                <i class="bi bi-scissors"></i>
                            </div>
                        </div>
                        <div class="kpi-value text-white">@Model.ClientesAtendidosHoy</div>
                        <div class="kpi-subtitle">
                            <span class="text-success"><i class="bi bi-check2-all me-1"></i>Cortes realizados</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card h-100">
                        <div class="kpi-header">
                            <span class="kpi-title">Citas Pendientes</span>
                            <div class="kpi-icon-wrapper kpi-icon-blue">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                        <div class="kpi-value text-white">@Model.CitasPendientesHoy</div>
                        <div class="kpi-subtitle">
                            <span class="text-secondary">Por atender hoy</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card h-100">
                        <div class="kpi-header">
                            <span class="kpi-title">Citas Canceladas</span>
                            <div class="kpi-icon-wrapper kpi-icon-rose">
                                <i class="bi bi-x-circle-fill"></i>
                            </div>
                        </div>
                        <div class="kpi-value text-white">@Model.CitasCanceladasHoy</div>
                        <div class="kpi-subtitle">
                            <span class="text-secondary">Turnos caídos hoy</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 💰 RENDIMIENTO DEL MES COMPARATIVO Y CUADRO DE HONOR -->
            <div class="row g-4 mb-4">
                <!-- Tarjeta Financiera Mensual -->
                <div class="col-12 col-md-5">
                    <div class="card p-4 h-100">
                        <span class="text-secondary text-uppercase small fw-bold">Ingresos Mensuales</span>
                        <div class="kpi-value my-2">$@Model.IngresosMes.ToString("N0")</div>
                        <div class="d-flex align-items-center mt-2">
                            <span class="badge @(Model.EsIngresoMayorMesAnterior ? "bg-success" : "bg-danger") me-2">
                                <i class="bi @(Model.EsIngresoMayorMesAnterior ? "bi-arrow-up" : "bi-arrow-down") me-1"></i>
                                @Math.Abs(Model.PorcentajeComparacionMesAnterior).ToString("N1")%
                            </span>
                            <span class="text-secondary small">vs mes anterior</span>
                        </div>
                    </div>
                </div>

                <!-- Líderes y Estadísticas Generales -->
                <div class="col-12 col-md-7">
                    <div class="card p-4 h-100">
                        <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-trophy-fill text-warning"></i> Líderes de la Sucursal
                        </h5>
                        <div class="row g-3 text-center">
                            <div class="col-6 col-sm-4 border-end" style="border-color: rgba(255,255,255,0.08) !important;">
                                <p class="text-secondary small mb-1">Servicio Top</p>
                                <h6 class="fw-bold text-white text-truncate px-1">@Model.ServicioMasVendido</h6>
                                <span class="badge bg-info">@Model.CantidadServicioMasVendido cortes</span>
                            </div>
                            <div class="col-6 col-sm-4 border-end" style="border-color: rgba(255,255,255,0.08) !important;">
                                <p class="text-secondary small mb-1">Barbero Estrella</p>
                                <h6 class="fw-bold text-white text-truncate px-1">@Model.BarberoEstrella</h6>
                                <span class="badge bg-success">@Model.CortesBarberoEstrella turnos</span>
                            </div>
                            <div class="col-12 col-sm-4">
                                <p class="text-secondary small mb-1">Capacidad Operativa</p>
                                <h6 class="fw-bold text-white">Staff Base</h6>
                                <span class="badge bg-secondary">@Model.TotalBarberos Barberos</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráficos de Chart.js -->
            <div class="row g-4 mb-4">
                <div class="col-md-7">
                    <div class="card p-3 h-100">
                        <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-person-lines-fill text-info"></i> Citas Asignadas por Barbero
                        </h5>
                        <div style="position: relative; height:260px; width:100%">
                            <canvas id="chartBarberosSede"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="card p-3 h-100">
                        <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-pie-chart text-warning"></i> Estado de las Citas del Mes
                        </h5>
                        <div style="position: relative; height:260px; width:100%">
                            <canvas id="chartEstadosCitas"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 🏆 TABLA TOP 10 CLIENTES -->
            <div class="card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-award-fill text-warning"></i> Top 10 Clientes Frecuentes
                    </h5>
                    <span class="badge bg-secondary">Por inversión acumulada</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Pos</th>
                                <th>Nombre Cliente</th>
                                <th class="text-center">Servicios Tomados</th>
                                <th class="text-end">Total Invertido</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Top10Clientes.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="empty-state border-0 my-0 py-3">
                                            <div class="empty-state-icon">
                                                <i class="bi bi-people"></i>
                                            </div>
                                            <h5 class="empty-state-title">Sin datos registrados este mes</h5>
                                            <p class="empty-state-desc">A medida que se completen servicios, verás aquí el ranking de clientes.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int puesto = 1;
                                foreach (var cliente in Model.Top10Clientes)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(puesto == 1 ? "bg-warning" : puesto == 2 ? "bg-secondary" : puesto == 3 ? "bg-danger" : "bg-dark")" style="width:28px; height:28px; border-radius:50%; justify-content:center; display:inline-flex;">
                                                @puesto
                                            </span>
                                        </td>
                                        <td><strong class="text-white">@cliente.NombreCliente</strong></td>
                                        <td class="text-center"><span class="badge bg-secondary">@cliente.TotalCitas citas</span></td>
                                        <td class="text-end fw-bold text-success">$@cliente.TotalGastado.ToString("N0")</td>
                                    </tr>
                                    puesto++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ⚡ ACCESOS RÁPIDOS PARA ADMINISTRADOR -->
            <div class="mt-4 pt-2">
                <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-grid-fill text-warning"></i> <span class="ms-2">Panel Operativo y Ejecutivo</span>
                </h5>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    <!-- Catálogo de Servicios -->
                    <div class="col">
                        <div class="card h-100 p-4 d-flex flex-column border-0 shadow-sm glass-card" style="background: rgba(31,41,55,0.45); backdrop-filter: blur(12px);">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-scissors fs-2 text-warning me-3"></i>
                                <h6 class="fw-bold text-white mb-0">Catálogo de Servicios</h6>
                            </div>
                            <p class="text-secondary flex-grow-1 mb-3">Explora y gestiona todos los servicios que ofreces, define precios y duraciones.</p>
                            <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-success w-100 fw-semibold">Ver Servicios <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                    <!-- Equipo de Barberos -->
                    <div class="col">
                        <div class="card h-100 p-4 d-flex flex-column border-0 shadow-sm glass-card" style="background: rgba(31,41,55,0.45); backdrop-filter: blur(12px);">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-person-badge-fill fs-2 text-info me-3"></i>
                                <h6 class="fw-bold text-white mb-0">Equipo de Barberos</h6>
                            </div>
                            <p class="text-secondary flex-grow-1 mb-3">Administra tu staff, asigna horarios y controla su disponibilidad.</p>
                            <a asp-controller="Barberos" asp-action="Index" class="btn btn-outline-info w-100 fw-semibold">Gestionar Equipo <i class="bi bi-arrow-right ms-1"></i></a>

                        </div>
                    </div>
                    <!-- Caja y Facturación -->
                    <div class="col">
                        <div class="card h-100 p-4 d-flex flex-column border-0 shadow-sm glass-card" style="background: rgba(31,41,55,0.45); backdrop-filter: blur(12px);">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-cash-stack fs-2 text-success me-3"></i>
                                <h6 class="fw-bold text-white mb-0">Caja y Facturación</h6>
                            </div>
                            <p class="text-secondary flex-grow-1 mb-3">Control total de ingresos, egresos y generación de facturas.</p>
                            <a asp-controller="Caja" asp-action="Index" class="btn btn-outline-warning w-100 fw-semibold">Abrir Caja <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* 📅 ======================================================== *@
    @* 🌟 SECCIÓN OPTIMIZADA PARA ROLES DE CLIENTE                  *@
    @* ========================================================== *@
    @if (User.IsInRole("Cliente"))
    {
        <h3 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-person-circle text-warning"></i> Tu Espacio Personal
        </h3>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
            <div class="col">
                <div class="card h-100 p-4 d-flex flex-column">
                    <div class="mb-3">
                        <div class="kpi-icon-wrapper kpi-icon-amber mb-3">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <h5 class="fw-bold text-white">Agendar Nueva Cita</h5>
                        <p class="text-secondary small">Elige tu servicio favorito, selecciona tu barbero de confianza y aparta tu cupo en un instante.</p>
                    </div>
                    <div class="mt-auto pt-3">
                        <a asp-controller="Citas" asp-action="Create" class="btn btn-primary w-100">
                            Reservar Turno Ahora <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-4 d-flex flex-column">
                    <div class="mb-3">
                        <div class="kpi-icon-wrapper kpi-icon-emerald mb-3">
                            <i class="bi bi-scissors"></i>
                        </div>
                        <h5 class="fw-bold text-white">Ver Cortes y Precios</h5>
                        <p class="text-secondary small">Explora nuestro catálogo completo de servicios disponibles, tarifas bases y tiempos de atención.</p>
                    </div>
                    <div class="mt-auto pt-3">
                        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-success w-100">
                            Consultar Servicios <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-4 d-flex flex-column">
                    <div class="mb-3">
                        <div class="kpi-icon-wrapper kpi-icon-blue mb-3">
                            <i class="bi bi-calendar2-check"></i>
                        </div>
                        <h5 class="fw-bold text-white">Mis Citas Programadas</h5>
                        <p class="text-secondary small">Consulta el historial de tus turnos, revisa cuáles están pendientes y verifica tus horarios.</p>
                    </div>
                    <div class="mt-auto pt-3">
                        <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-info w-100">
                            Ver Historial de Citas <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!User.IsInRole("Administrador"))
    {
        @* 👨‍💼 VISTA GENERAL DE ACCESOS RÁPIDOS *@
        <h3 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill text-warning"></i> Accesos Rápidos del Sistema
        </h3>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
            <div class="col">
                <div class="card h-100 p-4 d-flex flex-column">
                    <div class="mb-3">
                        <div class="kpi-icon-wrapper kpi-icon-amber mb-3">
                            <i class="bi bi-scissors"></i>
                        </div>
                        <h5 class="fw-bold text-white">Catálogo de Servicios</h5>
                        <p class="text-secondary small">Configura los cortes, lavados, tinturas y las tarifas bases por sucursal.</p>
                    </div>
                    <div class="mt-auto pt-3">
                        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-warning w-100">
                            Administrar Servicios <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-4 d-flex flex-column">
                    <div class="mb-3">
                        <div class="kpi-icon-wrapper kpi-icon-blue mb-3">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h5 class="fw-bold text-white">Staff de Barberos</h5>
                        <p class="text-secondary small">Gestiona el equipo de colaboradores, sus especialidades y comisiones.</p>
                    </div>
                    <div class="mt-auto pt-3">
                        <a asp-controller="Barberos" asp-action="Index" class="btn btn-outline-info w-100">
                            Ver Equipo de Barberos <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-4 d-flex flex-column">
                    <div class="mb-3">
                        <div class="kpi-icon-wrapper kpi-icon-emerald mb-3">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                        <h5 class="fw-bold text-white">Caja y Facturación</h5>
                        <p class="text-secondary small">Revisa el historial de cobros, procesa nuevos pagos y arqueos.</p>
                    </div>
                    <div class="mt-auto pt-3">
                        <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline-success w-100">
                            Revisar Finanzas <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* 🛠️ SCRIPTS DE CHART.JS *@
@if (User.IsInRole("Administrador") && Model != null)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // 1. Gráfico de Citas Totales por Barbero (Barras)
            const datosBarberos = @Html.Raw(Json.Serialize(Model.ClientesPorBarbero));
            const labelsBarberos = Object.keys(datosBarberos).length ? Object.keys(datosBarberos) : ["Sin barberos"];
            const valoresBarberos = Object.values(datosBarberos).length ? Object.values(datosBarberos) : [0];

            const ctxBarberos = document.getElementById('chartBarberosSede').getContext('2d');
            new Chart(ctxBarberos, {
                type: 'bar',
                data: {
                    labels: labelsBarberos,
                    datasets: [{
                        label: 'Número de Citas',
                        data: valoresBarberos,
                        backgroundColor: '#F59E0B',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#9CA3AF', font: { family: "'Plus Jakarta Sans', sans-serif" } },
                            grid: { color: 'rgba(255, 255, 255, 0.05)' }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, color: '#9CA3AF' },
                            grid: { color: 'rgba(255, 255, 255, 0.05)' }
                        }
                    }
                }
            });

            // 2. Gráfico de Resumen de Citas por Estado (Doughnut)
            const datosEstados = @Html.Raw(Json.Serialize(Model.ResumenCitasPorEstado));
            const labelsEstados = Object.keys(datosEstados).length ? Object.keys(datosEstados) : ["Sin estados"];
            const valoresEstados = Object.values(datosEstados).length ? Object.values(datosEstados) : [0];

            const ctxEstados = document.getElementById('chartEstadosCitas').getContext('2d');
            new Chart(ctxEstados, {
                type: 'doughnut',
                data: {
                    labels: labelsEstados,
                    datasets: [{
                        data: valoresEstados,
                        backgroundColor: ['#F59E0B', '#10B981', '#EF4444'],
                        borderColor: '#1F2937',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#9CA3AF',
                                font: { family: "'Plus Jakarta Sans', sans-serif", size: 12 },
                                padding: 12,
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        }
                    }
                }
            });
        </script>
    }
}
@model SaaSBarberia.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-sm text-center position-relative overflow-hidden">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-gradient" style="opacity: 0.1; background: linear-gradient(45deg, #ff0000, #0000ff);"></div>
        <h1 class="display-4 fw-bold mb-2">¡Otra vez tu, care verga, ¿ahora que?! 💈😂</h1>
        <p class="fs-5 text-muted">Bienvenido al núcleo operacional de tu SaaS de Barberías. Todo está sincronizado y listo para camellar.</p>
    </div>

    @* 📊 ======================================================== *@
    @* 🌟 SECCIÓN EXCLUSIVA DEL DASHBOARD PARA ADMINBARBERIA       *@
    @* ========================================================== *@
    @if (User.IsInRole("AdminBarberia") && Model != null)
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold text-dark m-0">📊 Dashboard de Operaciones Sede</h3>
                <span class="badge bg-success px-3 py-2 fs-6">Datos en Tiempo Real</span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-primary h-100 transition-card">
                        <small class="text-secondary uppercase fw-bold small">Citas de Hoy</small>
                        <h2 class="fw-bold text-dark my-1">📆 @Model.CitasParaHoy</h2>
                        <small class="text-muted">Por atender</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success h-100 transition-card">
                        <small class="text-secondary uppercase fw-bold small">Ingresos Mensuales</small>
                        <h2 class="fw-bold text-success my-1">$@Model.IngresosMesActual.ToString("N0")</h2>
                        <small class="text-muted">Mes en curso</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-info h-100 transition-card">
                        <small class="text-secondary uppercase fw-bold small">Servicios Totales</small>
                        <h2 class="fw-bold text-dark my-1">✂️ @Model.TotalServiciosRealizados</h2>
                        <small class="text-muted">Cortes cobrados</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm bg-dark text-white p-3 h-100 transition-card">
                        <small class="text-white-50 uppercase fw-bold small">🏆 Barbero Estrella</small>
                        <h4 class="fw-bold text-warning mt-2 mb-1 text-truncate">@Model.BarberoEstrella</h4>
                        <small class="text-white-50">@Model.CortesBarberoEstrella servicios completados</small>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-2">
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3">💵 Historial de Ventas (7 Días)</h5>
                        <div style="position: relative; height:260px; width:100%">
                            <canvas id="chartVentasSede"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="card border-0 shadow-sm p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3">💈 Servicios Más Demandados</h5>
                        <div style="position: relative; height:260px; width:100%">
                            <canvas id="chartServiciosSede"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr class="my-5" />
    }

    @* 📅 ======================================================== *@
    @* 🌟 SECCIÓN OPTIMIZADA PARA ROLES DE CLIENTE                 *@
    @* ========================================================== *@
    @if (User.IsInRole("Cliente"))
    {
        <h3 class="text-secondary fw-bold mb-3">📅 Tu Espacio Personal</h3>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-primary border-4 transition-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">⚡ Agendar Nueva Cita</h5>
                        <p class="card-text text-muted small">Elige tu servicio favorito, selecciona tu barbero de confianza y aparta tu cupo en un segundo.</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <a asp-controller="Citas" asp-action="Create" class="btn btn-primary w-100 fw-bold">Reservar Turno Ahora →</a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-success border-4 transition-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">✂️ Ver Cortes y Precios</h5>
                        <p class="card-text text-muted small">Explora nuestro catálogo completo de servicios disponibles, tarifas bases y tiempos de atención.</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-success w-100 fw-semibold">Consultar Servicios →</a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-info border-4 transition-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">📋 Mis Citas Programadas</h5>
                        <p class="card-text text-muted small">Consulta el historial de tus turnos, revisa cuáles están pendientes y verifica tus horarios.</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-info w-100 fw-semibold">Ver Historial de Citas →</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* 👨‍💼 VISTA GENERAL DE ACCESOS RÁPIDOS (ADMINS Y SUPERADMINS) *@
        <h3 class="text-secondary fw-bold mb-3">🛠️ Accesos Rápidos del Sistema</h3>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-primary border-4 transition-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">✂️ Catálogo de Servicios</h5>
                        <p class="card-text text-muted small">Configura los cortes, lavados, tinturas y las tarifas bases por sucursal.</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 fw-semibold">Administrar Servicios →</a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-warning border-4 transition-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">💈 Staff de Barberos</h5>
                        <p class="card-text text-muted small">Gestiona el equipo de colaboradores, sus especialidades y los porcentajes de comisión.</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <a asp-controller="Barberoes" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 fw-semibold text-dark">Ver Equipo de Barberos →</a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-success border-4 transition-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">💵 Caja y Facturación</h5>
                        <p class="card-text text-muted small">Revisa el historial de cobros, procesa nuevos pagos y mantén las cuentas melas.</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline-success btn-sm w-100 fw-semibold">Revisar Finanzas →</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .transition-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1) !important;
        }
</style>

@* 🛠️ SCRIPTS DE CHART.JS EXCLUSIVOS PARA CUANDO SE RENDERICE EL DASHBOARD *@
@if (User.IsInRole("AdminBarberia") && Model != null)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // 1. Data del gráfico de Ventas Semanales
            const datosVentas = @Html.Raw(Json.Serialize(Model.VentasUltimosDias));
            const labelsVentas = Object.keys(datosVentas).length ? Object.keys(datosVentas) : ["Sin datos"];
            const valoresVentas = Object.values(datosVentas).length ? Object.values(datosVentas) : [0];

            const ctxVentas = document.getElementById('chartVentasSede').getContext('2d');
            new Chart(ctxVentas, {
            type: 'bar',
            data: {
            labels: labelsVentas,
            datasets: [{
            label: 'Ingresos ($)',
            data: valoresVentas,
            backgroundColor: '#0d6efd',
            borderRadius: 5
            }]
            },
            options: { responsive: true, maintainAspectRatio: false }
            });

            // 2. Data del gráfico de Servicios Populares
            const datosServicios = @Html.Raw(Json.Serialize(Model.ServiciosMasPedidos));
            const labelsServicios = Object.keys(datosServicios).length ? Object.keys(datosServicios) : ["Sin servicios"];
            const valoresServicios = Object.values(datosServicios).length ? Object.values(datosServicios) : [0];

            const ctxServicios = document.getElementById('chartServiciosSede').getContext('2d');
            new Chart(ctxServicios, {
            type: 'pie',
            data: {
            labels: labelsServicios,
            datasets: [{
            data: valoresServicios,
            backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6c757d']
            }]
            },
            options: { responsive: true, maintainAspectRatio: false }
            });
        </script>
    }
}
@model IEnumerable<SaaSBarberia.Models.Servicio>

@{
    ViewData["Title"] = "Catálogo de Servicios";
}

<div class="container mt-4">
    <div class="text-center p-5 bg-dark text-white rounded-4 shadow mb-5">
        <h1 class="display-4 fw-bold">💈 Bienvenido a SaaS Barbería</h1>
        <p class="lead">Conoce nuestros servicios y agenda tu turno con los mejores profesionales.</p>
    </div>

    <h2 class="text-dark fw-bold mb-4">✂ Nuestro Catálogo de Servicios</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-primary border-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="card-title fw-bold text-dark mb-0">@item.Nombre</h4>
                                <span class="fs-5 fw-bold text-success">$@item.Precio.ToString("N0")</span>
                            </div>
                            <p class="text-muted small">⏱ <strong>Duración:</strong> @item.DuracionMinutos min</p>
                        </div>

                        <div class="mt-3">
                            <div class="bg-light p-2 rounded-2 mb-3">
                                <small class="text-secondary d-block">🏢 Sede:</small>
                                <span class="fw-semibold text-dark">@(item.Tenant?.NombreNegocio ?? "Global")</span>
                            </div>
                            @* Al darle Reservar lo mandamos al flujo de citas, que le exigirá login *@
                            <a asp-controller="Citas" asp-action="Create" class="btn btn-primary w-100 fw-bold shadow-sm">⚡ Reservar Turno</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
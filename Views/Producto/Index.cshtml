@model IEnumerable<SaaSBarberia.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<h1>Inventario de Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Producto</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
            <th>Precio de Venta</th>
            <th>Existencias (Stock)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td><strong>@Html.DisplayFor(modelItem => item.Nombre)</strong></td>
            <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
            <td>$@item.PrecioVenta.ToString("N2")</td>
            <td>
                <span class="badge @(item.Stock > 5 ? "bg-success" : "bg-danger")">
                    @Html.DisplayFor(modelItem => item.Stock) unds
                </span>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
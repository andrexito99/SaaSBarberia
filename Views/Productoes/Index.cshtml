@model IEnumerable<SaaSBarberia.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
    // Dejamos la variable lista para no repetir código
    bool esCliente = User.IsInRole("Cliente");
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-dark m-0">🛒 Inventario de Productos</h1>

        @* 🔒 EL BOTÓN DE CREAR SÓLO LE SALE AL ADMIN/SUPERADMIN *@
        @if (!esCliente)
        {
            <a asp-action="Create" class="btn btn-primary px-4 fw-semibold shadow-sm">
                ➕ Crear Nuevo Producto
            </a>
        }
    </div>

    @* 🎴 REJILLA DE CARDS RESPONSIVAS *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3 position-relative">

                    @* Badge de Stock flotando en la esquina superior derecha *@
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge @(item.Stock > 5 ? "bg-success" : "bg-danger") px-2 py-1 fs-7 shadow-sm">
                            @item.Stock unds
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column pt-4">
                        @* Nombre del Producto *@
                        <h5 class="card-title fw-bold text-truncate pe-5 mb-1" title="@item.Nombre">
                            @item.Nombre
                        </h5>

                        @* Precio formateado *@
                        <p class="text-primary fw-bold fs-5 mb-2">
                            $@item.PrecioVenta.ToString("N2")
                        </p>

                        @* Descripción con límite de altura para que no des cuadre las tarjetas *@
                        <p class="card-text text-muted small flex-grow-1 text-overflow-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción disponible." : item.Descripcion)
                        </p>

                        @* 🛠️ BOTONES DE ACCIÓN EN EL FOOTER DE LA CARD *@
                        <div class="d-flex gap-2 mt-3 pt-3 border-top border-light">
                            @* El botón de detalles SIEMPRE lo ve el cliente y los admins *@
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary flex-grow-1 fw-semibold">
                                👀 Detalles
                            </a>

                            @* 🔒 EDICIÓN Y BORRADO SÓLO SI NO ES CLIENTE *@
                            @if (!esCliente)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                    ✏️ Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    🗑️ Borrar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
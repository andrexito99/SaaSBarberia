@model SaaSBarberia.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">📦 Crear Nuevo Producto</h3>
        <h5 class="text-muted small mb-4">Ficha de Control de Inventario</h5>

        <form asp-action="Create" enctype="multipart/form-data" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre del Producto</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Gel fijador Max" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ej: Tarro de 500ml" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="PrecioVenta" class="form-label fw-semibold">Precio de Venta</label>
                    <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>

                <div class="col-6 mb-3">
                    <label asp-for="Stock" class="form-label fw-semibold">Inventario Inicial</label>
                    <input asp-for="Stock" class="form-control" type="number" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-dark">Imagen Comercial del Producto</label>
                <input type="file" name="productoArchivo" id="productoArchivo" class="form-control" accept="image/*" />
                <small class="text-muted">Asegúrate de que la foto sea clara para incentivar la venta.</small>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Regresar</a>
                <button type="submit" class="btn btn-primary px-4">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
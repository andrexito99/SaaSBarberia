@model SaaSBarberia.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<h1>Detalles de Producto</h1>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-3">Precio Establecido</dt>
        <dd class="col-sm-9">$@Model.PrecioVenta.ToString("N2")</dd>

        <dt class="col-sm-3">Unidades en Almacén</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Stock) unidades</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Editar Datos</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver al Inventario</a>
</div>
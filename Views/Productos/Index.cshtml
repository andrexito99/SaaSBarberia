@model IEnumerable<SaaSBarberia.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container my-4">
    <!-- Encabezado Estilizado -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold text-dark"><i class="fas fa-boxes me-2"></i>Catálogo de Productos</h1>
            <p class="text-muted mb-0">Gestiona el inventario y los productos disponibles en tu barbería</p>
        </div>
        @if (User.IsInRole("AdminBarberia") || User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-dark btn-lg shadow-sm">
                <i class="fas fa-plus-circle me-2"></i>Crear Nuevo Producto
            </a>
        }
    </div>

    <!-- Grid del Catálogo en Tarjetas (Cards) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center my-5">
                <div class="p-5 bg-light rounded-3 shadow-sm">
                    <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                    <p class="h4 text-secondary">No hay productos registrados en esta barbería, care verga.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-3 hover-shadow transition-all">
                        <!-- Cuerpo de la tarjeta -->
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="card-title fw-bold text-truncate mb-0" style="max-width: 80%;">
                                    @item.Nombre
                                </h4>
                                <!-- Badge de Stock Inteligente -->
                                <span class="badge rounded-pill p-2 @(item.Stock > 5 ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                                    <i class="fas @(item.Stock > 5 ? "fa-check-circle" : "fa-exclamation-triangle") me-1"></i>
                                    @item.Stock unds
                                </span>
                            </div>

                            <p class="card-text text-muted small flex-grow-1 mb-4">
                                @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción disponible." : item.Descripcion)
                            </p>

                            <!-- Precio Destacado -->
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-light">
                                <div class="text-secondary small">Precio de venta</div>
                                <div class="h3 fw-extrabold text-dark mb-0">$@item.PrecioVenta.ToString("N0")</div>
                            </div>
                        </div>

                        <!-- Acciones del Administrador en el Footer de la Card -->
                        <div class="card-footer bg-light border-0 p-3 d-flex gap-2 justify-content-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-3" title="Detalles">
                                <i class="fas fa-eye"></i> Ver
                            </a>
                            @if (User.IsInRole("AdminBarberia") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3" title="Eliminar">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Estilos rápidos para darle el toque premium -->
<style>
    .transition-all {
        transition: all 0.3s ease-in-out;
    }
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
    }
    .fw-extrabold {
        font-weight: 800;
    }
    .bg-success-subtle {
        background-color: #d1e7dd !important;
    }
    .bg-danger-subtle {
        background-color: #f8d7da !important;
    }
</style>
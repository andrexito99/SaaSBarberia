@model IEnumerable<SaaSBarberia.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container my-4" data-listing>
    <!-- Encabezado Estilizado -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-bag-check-fill text-warning"></i> Catálogo de Productos
            </h1>
            <p class="text-secondary small mb-0 mt-1">Gestiona el inventario, suministros y artículos en venta</p>
        </div>
        @if (User.IsInRole("Administrador") || User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle-fill"></i> Crear Nuevo Producto
            </a>
        }
    </div>

    <!-- Grid del Catálogo en Tarjetas (Cards) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" data-listing-grid>
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h3 class="empty-state-title">No hay productos registrados</h3>
                    <p class="empty-state-desc">Aún no se han añadido productos al inventario de esta sede.</p>
                    @if (User.IsInRole("Administrador") || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-lg"></i> Agregar Primer Producto
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 overflow-hidden">

                        <!-- 📸 Renderizado de Imagen desde Disco Duro -->
                        <div class="position-relative text-center d-flex align-items-center justify-content-center" 
                             style="height: 200px; overflow: hidden; background: rgba(17, 24, 39, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                            @if (!string.IsNullOrEmpty(item.RutaImagen))
                            {
                                <img src="@item.RutaImagen" class="w-100 h-100" style="object-fit: cover;" alt="@item.Nombre" />
                            }
                            else
                            {
                                <div class="text-secondary opacity-75">
                                    <i class="bi bi-box-seam display-4 mb-2 d-block text-muted"></i>
                                    <span class="small">Sin Imagen Registrada</span>
                                </div>
                            }
                        </div>

                        <!-- Cuerpo de la tarjeta -->
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                <h4 class="card-title fw-bold text-truncate mb-0 text-white" style="max-width: 65%;">
                                    @item.Nombre
                                </h4>
                                <!-- Badge de Stock Inteligente -->
                                <span class="badge @(item.Stock > 5 ? "bg-success" : "bg-danger")">
                                    <i class="bi @(item.Stock > 5 ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
                                    @item.Stock unds
                                </span>
                            </div>

                            <p class="card-text text-secondary small flex-grow-1 mb-4">
                                @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción disponible." : item.Descripcion)
                            </p>

                            <!-- Precio Destacado -->
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                <div class="text-secondary small">Precio de venta</div>
                                <div class="h3 fw-bold text-success mb-0">$@item.PrecioVenta.ToString("N0")</div>
                            </div>
                        </div>

                        <!-- Acciones en el Footer de la Card -->
                        <div class="card-footer d-flex gap-2 justify-content-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalles">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            @if (User.IsInRole("Administrador") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

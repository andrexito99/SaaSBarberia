@model SaaSBarberia.Models.Servicio

@{
    ViewData["Title"] = "Eliminar Servicio";
}

<div class="container mt-4" style="max-width: 450px;">
    <div class="card shadow border-0 p-4 border-top border-danger border-4 text-center">
        <h4 class="text-danger fw-bold">🗑 ¿Eliminar este servicio del catálogo?</h4>
        <p class="text-muted mt-2">Vas a remover el servicio <strong>@Model.Nombre</strong>. Esta acción no se puede deshacer.</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">No, conservar</a>
                <input type="submit" value="Sí, eliminar" class="btn btn-danger px-4" />
            </div>
        </form>
    </div>
</div>
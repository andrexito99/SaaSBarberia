@model IEnumerable<SaaSBarberia.Models.Servicio>

@{
    ViewData["Title"] = "Servicios Ofrecidos";
}

<div class="container mt-4" data-listing>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white fw-bold m-0 d-flex align-items-center gap-2">
                <i class="bi bi-scissors text-warning"></i> Catálogo de Servicios
            </h2>
            <p class="text-secondary small mb-0 mt-1">Configuración de cortes, tratamientos y tarifas vigentes</p>
        </div>

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle-fill"></i> Agregar Servicio
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-scissors"></i>
            </div>
            <h4 class="empty-state-title">No hay servicios registrados</h4>
            <p class="empty-state-desc">Comienza agregando los cortes o procedimientos que ofrece tu barbería.</p>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-lg"></i> Crear Primer Servicio
                </a>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" data-listing-grid>
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 position-relative overflow-hidden">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                <h4 class="card-title fw-bold text-white mb-0 text-truncate">@item.Nombre</h4>
                                <span class="fs-5 fw-bold text-success text-nowrap">$@item.Precio.ToString("N0")</span>
                            </div>

                            <p class="text-secondary mb-3 small">
                                <i class="bi bi-stopwatch text-warning me-1"></i>
                                <span>Duración estimada:</span> <strong class="text-white">@item.DuracionMinutos min</strong>
                            </p>

                            <div class="p-2 rounded-3 mt-auto" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06);">
                                <small class="text-secondary d-block" style="font-size: 0.72rem;">DISPONIBLE EN SEDE:</small>
                                <span class="fw-semibold text-white small">
                                    <i class="bi bi-shop me-1 text-info"></i>@(item.Tenant?.NombreNegocio ?? "Global")
                                </span>
                            </div>
                        </div>

                        <!-- Card Footer Adaptativo -->
                        <div class="card-footer d-flex gap-2 justify-content-between">
                            @if (User.IsInRole("Cliente"))
                            {
                                <!-- Le mandamos el servicioId seleccionado -->
                                <a asp-controller="Citas" asp-action="Create" asp-route-servicioId="@item.Id" class="btn btn-primary w-100">
                                    <i class="bi bi-lightning-charge-fill"></i> Reservar Cita
                                </a>
                            }
                            else if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-fill">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info flex-fill">
                                    <i class="bi bi-eye me-1"></i>Detalles
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger flex-fill">
                                    <i class="bi bi-trash me-1"></i>Borrar
                                </a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-100">
                                    <i class="bi bi-eye me-1"></i>Ver Detalles
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
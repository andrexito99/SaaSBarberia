@model IEnumerable<SaaSBarberia.Models.Servicio>

@{
    ViewData["Title"] = "Servicios Ofrecidos";
}

<div class="container mt-4" data-listing>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">✂ Catálogo de Servicios</h2>

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">+ Agregar Servicio</a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4" data-listing-grid>
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="card-title fw-bold text-dark mb-0">@item.Nombre</h4>
                            <span class="fs-5 fw-bold text-success">$@item.Precio.ToString("N0")</span>
                        </div>

                        <p class="text-muted mb-2 small">
                            ⏱ <strong>Duración:</strong> @item.DuracionMinutos min
                        </p>

                        <div class="bg-light p-2 rounded-2 mt-3">
                            <small class="text-secondary d-block">🏢 Disponible en Sede:</small>
                            <span class="fw-semibold text-dark">@(item.Tenant?.NombreNegocio ?? "Global")</span>
                        </div>
                    </div>

                    @* 🌟 FOOTER ADAPTATIVO POR ROL DE USUARIO 🌟 *@
                    <div class="card-footer bg-white border-0 pb-3">
                        @if (User.IsInRole("Cliente"))
                        {
                            <a asp-controller="Citas" asp-action="Create" class="btn btn-primary w-100 fw-bold shadow-sm">⚡ Reservar Cita</a>
                        }
                        else if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
                        {
                            <div class="d-flex justify-content-around">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning w-25">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-25">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-25">Borrar</a>
                            </div>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-100">Ver Detalles</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

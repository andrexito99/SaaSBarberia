<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaaSBarberia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SaaSBarberia.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom box-shadow mb-4 py-3">
            <div class="container shadow-sm">
                <a class="navbar-brand fw-bold text-uppercase tracking-wider" asp-area="" asp-controller="Home" asp-action="Index">
                    💈 SaaS Barbería
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">🏠 Inicio</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item ms-2">
                                <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-controller="Servicios" asp-action="Index">✂️ Servicios</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-controller="Barberoes" asp-action="Index">💈 Barberos</a>
                            </li>

                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrador"))
                            {
                                <li class="nav-item ms-2">
                                    <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-controller="Facturas" asp-action="Index">💵 Facturación</a>
                                </li>
                            }

                            <li class="nav-item ms-2">
                                <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-controller="Citas" asp-action="Index">📆 Citas</a>
                            </li>

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item ms-2 border-start border-secondary ps-2">
                                    <a class="nav-link text-warning fw-semibold" asp-area="" asp-controller="Tenants" asp-action="Index">🏢 Tenants</a>
                                </li>
                                <li class="nav-item ms-2">
                                    <a class="nav-link text-warning fw-semibold" asp-area="" asp-controller="Usuarios" asp-action="Index">👥 Usuarios Globales</a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-white small me-1">Hola, <strong>@User.Identity.Name</strong></span>
                            <span class="badge bg-danger px-3 py-2 fw-bold shadow-sm">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value.ToUpper()
                            </span>
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">Salir</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-bottom: 80px;">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 position-fixed bottom-0 start-0 w-100 z-3">
        <div class="container text-center text-md-start d-md-flex justify-content-between">
            <span>&copy; 2026 - <strong>SaaSBarberia</strong> - Desarrollado con C# y Mucho Flow.</span>
            <span class="text-secondary small">Valledupar, Cesar 🇨🇴</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
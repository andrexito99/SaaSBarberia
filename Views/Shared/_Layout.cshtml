@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject SaaSBarberia.Data.BarberSaaSDbContext Context

@{
    string colorPrimario = "#212529";
    string colorSecundario = "#0d6efd";
    string estiloSidebar = "SuperiorClasico";
    string nombreNegocio = "SaaS Barbería";
    bool tieneHerramientas = false;

    bool esSuperAdmin = User.IsInRole("SuperAdmin");

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var usuarioIdStr = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(usuarioIdStr) && int.TryParse(usuarioIdStr, out int usuarioId))
        {
            var usuarioDb = Context.Usuarios
                .IgnoreQueryFilters()
                .Include(u => u.Tenant)
                .FirstOrDefault(u => u.Id == usuarioId);

            if (usuarioDb != null && usuarioDb.Tenant != null)
            {
                tieneHerramientas = usuarioDb.Tenant.TieneModuloHerramientas;

                if (!esSuperAdmin)
                {
                    colorPrimario = usuarioDb.Tenant.ColorPrimario ?? colorPrimario;
                    colorSecundario = usuarioDb.Tenant.ColorSecundario ?? colorSecundario;
                    estiloSidebar = usuarioDb.Tenant.EstiloSidebar ?? estiloSidebar;
                    nombreNegocio = usuarioDb.Tenant.NombreNegocio ?? nombreNegocio;
                }
                else
                {
                    colorPrimario = "#0f172a";
                    colorSecundario = "#258cfb";
                    estiloSidebar = "LateralOscuro"; // 🔥 Cambiado de SuperiorClasico a LateralOscuro para el SuperAdmin
                    nombreNegocio = "Panel SuperAdmin";
                    tieneHerramientas = true;
                }
            }
        }
    }

    // 🔥 Ahora el Layout Lateral se activa si es un tenant con sidebar lateral O si es el mismísimo SuperAdmin
    bool usaLayoutLateral = ((estiloSidebar == "LateralOscuro" || estiloSidebar == "LateralClaro") && !esSuperAdmin) || esSuperAdmin;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @nombreNegocio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SaaSBarberia.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --tenant-primary: @colorPrimario;
                --tenant-secondary: @colorSecundario;
            }

            .bg-tenant-custom {
                background-color: var(--tenant-primary) !important;
            }

            .text-tenant-brand {
                color: var(--tenant-secondary) !important;
            }

            .btn-tenant-action {
                background-color: var(--tenant-secondary) !important;
                border-color: var(--tenant-secondary) !important;
                color: #fff !important;
            }

                .btn-tenant-action:hover {
                    filter: brightness(90%);
                }
    </style>
</head>
<body class="bg-light">

    <div class="@(usaLayoutLateral ? "saas-wrapper" : "")">

        @* 📊 MENÚ LATERAL *@
        @if (usaLayoutLateral)
        {
            <nav class="saas-sidebar d-flex flex-column flex-shrink-0 p-3 shadow @(estiloSidebar == "LateralClaro" ? "bg-white text-dark border-end" : "text-white")"
                 style="@(estiloSidebar == "LateralOscuro" ? $"background-color: {colorPrimario} !important;" : "")">

                <a class="navbar-brand fw-bold text-uppercase tracking-wider text-center py-2" asp-controller="Home" asp-action="Index">
                    💈 <span class="text-tenant-brand">@nombreNegocio</span>
                </a>
                <hr>
                <ul class="nav nav-pills flex-column mb-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white") fw-semibold" asp-controller="Home" asp-action="Index">🏠 Inicio</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="Servicios" asp-action="Index">✂️ Servicios</a></li>
                        <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="Productos" asp-action="Index">🛒 Productos</a></li>

                        if (!User.IsInRole("Cliente"))
                        {
                            <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="Barberos" asp-action="Index">💈 Barberos</a></li>

                            @if (tieneHerramientas)
                            {
                                <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="AlquileresHerramientas" asp-action="Index">🔧 Alquiler Máquinas</a></li>
                                <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold text-warning" asp-controller="Herramientas" asp-action="Create">⚙️ + Herramienta</a></li>
                            }
                        }
                        if (User.IsInRole("AdminBarberia"))
                        {
                            <li><a class="nav-link text-danger fw-bold" asp-controller="Tenants" asp-action="DashboardSede">🚨 CONTROL</a></li>
                            <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="Caja" asp-action="Index">💵 Caja Chica</a></li>
                            @* 📅 AUSENCIAS EN MENÚ LATERAL (SÓLO ADMIN) *@
                            <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="BarberoAusencias" asp-action="Index">📅 Ausencias Barberos</a></li>
                        }
                        <li><a class="nav-link @(estiloSidebar == "LateralClaro" ? "text-dark" : "text-white-50") fw-semibold" asp-controller="Citas" asp-action="Index">📆 Citas</a></li>
                        
                        @* 🔥 Secciones exclusivas de SuperAdmin añadidas al menú lateral *@
                        if (esSuperAdmin)
                        {
                            <hr class="my-2 border-secondary">
                            <li class="nav-item"><a class="nav-link text-info fw-bold" asp-controller="Tenants" asp-action="SuperDashboard">📈 Global</a></li>
                            <li class="nav-item"><a class="nav-link text-warning fw-semibold" asp-controller="Tenants" asp-action="Index">🏢 Tenants</a></li>
                            <li class="nav-item"><a class="nav-link text-warning fw-semibold" asp-controller="Usuarios" asp-action="Index">👥 Usuarios</a></li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold" asp-controller="Auditoria" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill text-danger"></i> Auditoría Global
                                </a>
                            </li>
                        }
                    }
                </ul>
                <hr>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="d-flex flex-column gap-2 pt-2 border-top border-secondary">
                        <span class="small text-truncate text-white-50">Hola, <strong>@User.Identity.Name</strong></span>
                        <a class="btn btn-sm btn-danger w-100" asp-controller="Account" asp-action="Logout">Salir</a>
                    </div>
                }
                else
                {
                    <div class="pt-2">
                        <a class="btn btn-sm btn-tenant-action w-100" asp-controller="Account" asp-action="Login">Iniciar Sesión 🔑</a>
                    </div>
                }
            </nav>
        }

        <div class="saas-content @(usaLayoutLateral ? "has-sidebar" : "")">

            @* 🍔 MENÚ SUPERIOR (Sólo para no-SuperAdmins que usen Layout Superior) *@
            @if (!usaLayoutLateral)
            {
                <header>
                    <nav class="navbar navbar-expand-md navbar-dark border-bottom box-shadow mb-4 py-3" style="background-color: @colorPrimario !important;">
                        <div class="container-fluid px-4">
                            <a class="navbar-brand fw-bold text-uppercase tracking-wider" asp-controller="Home" asp-action="Index">
                                💈 <span class="text-tenant-brand">@nombreNegocio</span>
                            </a>

                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsiveContent" aria-controls="navbarResponsiveContent" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <div class="navbar-collapse collapse" id="navbarResponsiveContent">
                                <ul class="navbar-nav flex-grow-1 ms-md-3 my-2 my-md-0">
                                    <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">🏠 Inicio</a></li>
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="Servicios" asp-action="Index">✂️ Servicios</a></li>
                                        <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="Productos" asp-action="Index">🛒 Productos</a></li>

                                        if (!User.IsInRole("Cliente"))
                                        {
                                            <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="Barberos" asp-action="Index">💈 Barberos</a></li>

                                            @if (tieneHerramientas)
                                            {
                                                <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="AlquileresHerramientas" asp-action="Index">🔧 Alquiler Máquinas</a></li>
                                                <li class="nav-item"><a class="nav-link text-warning fw-semibold" asp-controller="Herramientas" asp-action="Create">⚙️ + Herramienta</a></li>
                                            }
                                        }
                                        if (User.IsInRole("SuperAdmin") || User.IsInRole("AdminBarberia"))
                                        {
                                            <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="Facturas" asp-action="Index">💵 Facturación</a></li>
                                        }
                                        if (User.IsInRole("AdminBarberia"))
                                        {
                                            <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="Caja" asp-action="Index">💰 Caja Chica</a></li>
                                            @* 📅 AUSENCIAS EN MENÚ SUPERIOR (SÓLO ADMIN) *@
                                            <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="BarberoAusencias" asp-action="Index">📅 Ausencias Barberos</a></li>
                                        }
                                        <li class="nav-item"><a class="nav-link text-white-50 fw-semibold" asp-controller="Citas" asp-action="Index">📆 Citas</a></li>
                                        if (User.IsInRole("AdminBarberia"))
                                        {
                                            <li class="nav-item"><a class="nav-link text-danger fw-bold" asp-controller="Tenants" asp-action="DashboardSede">🚨 CONTROL</a></li>
                                        }
                                    }
                                </ul>
                                <div class="d-flex flex-column flex-md-row align-items-md-center gap-2 mt-2 mt-md-0 pt-2 pt-md-0 border-top border-secondary border-md-0">
                                    <span class="text-white small text-truncate">Hola, <strong>@User.Identity.Name</strong></span>
                                    <a class="btn btn-sm btn-danger" asp-controller="Account" asp-action="Logout">Salir</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </header>
            }

            <div class="container-fluid px-3 px-md-4" style="margin-bottom: 100px; padding-top: @(usaLayoutLateral ? "20px" : "0px");">
                <main role="main" class="pb-5">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted bg-white py-3 position-fixed bottom-0 start-0 w-100 z-3"
                    style="padding-left: @(usaLayoutLateral ? "280px" : "20px"); transition: padding 0.3s ease;">
                <div class="container-fluid px-4 text-center text-md-start d-md-flex justify-content-between small">
                    <span>&copy; 2026 - <strong>@nombreNegocio</strong> - Control SaaS Adaptativo.</span>
                    <span class="text-secondary d-block d-md-inline mt-1 mt-md-0">Valledupar, Cesar 🇨🇴</span>
                </div>
            </footer>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="dropdown position-fixed top-0 end-0 m-3 z-3" id="notificacionesWidget">
            @Html.AntiForgeryToken()
            <button class="btn btn-light shadow-sm position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notificaciones">
                <i class="bi bi-bell-fill"></i><span id="contadorNotificaciones" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow p-0" style="width: 360px; max-width: calc(100vw - 24px);">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom"><strong>Notificaciones</strong><button id="marcarTodasNotificaciones" class="btn btn-link btn-sm p-0">Marcar todas</button></div>
                <div id="notificacionesDropdown"></div>
                <div class="p-2 text-center border-top"><a asp-controller="Notificaciones" asp-action="Index" class="small">Ver todas</a></div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (() => {
                const token = document.querySelector('#notificacionesWidget input[name="__RequestVerificationToken"]')?.value;
                const headers = token ? { 'RequestVerificationToken': token } : {};
                async function actualizar() {
                    const [dropdown, conteo] = await Promise.all([fetch('/Notificaciones/Dropdown'), fetch('/Notificaciones/ObtenerNoLeidas')]);
                    if (dropdown.ok) document.getElementById('notificacionesDropdown').innerHTML = await dropdown.text();
                    if (conteo.ok) { const data = await conteo.json(); const badge = document.getElementById('contadorNotificaciones'); badge.textContent = data.cantidad; badge.classList.toggle('d-none', data.cantidad === 0); }
                }
                async function post(url) { await fetch(url, { method: 'POST', headers }); await actualizar(); }
                document.getElementById('marcarTodasNotificaciones')?.addEventListener('click', () => post('/Notificaciones/MarcarTodas'));
                document.addEventListener('click', event => { const enlace = event.target.closest('[data-notification-link]'); if (enlace) post('/Notificaciones/MarcarLeida?id=' + enlace.dataset.notificationLink); const borrar = event.target.closest('.eliminar-notificacion'); if (borrar) { event.preventDefault(); post('/Notificaciones/Eliminar?id=' + borrar.dataset.id); borrar.closest('[data-id]')?.remove(); } });
                document.getElementById('marcarTodas')?.addEventListener('click', () => post('/Notificaciones/MarcarTodas'));
                actualizar(); setInterval(actualizar, 60000);
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
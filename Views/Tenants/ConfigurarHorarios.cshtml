@model List<SaaSBarberia.Models.HorarioLaboral>

@{
    ViewData["Title"] = "Configurar Horarios";
    string[] dias = { "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0 text-dark">📅 Configurar Horarios de Atención</h3>
            <span class="badge bg-success fs-6 px-3 py-2">Paso 2 de 2</span>
        </div>
        <p class="text-muted small">Define los bloques de tiempo de la barbería recién creada.</p>

        <form asp-action="ConfigurarHorarios" method="post" autocomplete="off">
            <input type="hidden" name="tenantId" value="@ViewBag.TenantId" />

            <div class="mb-3">
                <label class="form-label fw-semibold text-muted small d-block">Ajustes Rápidos (Presets):</label>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary" onclick="aplicarPreset('08:00', '18:00', null, null, '1')">⚡ 8 AM - 6 PM (Corrido)</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="aplicarPreset('08:00', '12:00', '14:00', '19:00', '2')">⚡ Comercial (2 Jornadas)</button>
                </div>
            </div>

            <div class="mb-3 card p-3 bg-light border-0 d-flex flex-sm-row align-items-center justify-content-between gap-3">
                <div class="flex-grow-1 w-100">
                    <label class="form-label fw-bold text-dark mb-0">Modalidad de Jornada:</label>
                    <select id="selectorJornada" name="selectorJornada" class="form-select form-select-sm mt-1 fw-semibold text-primary">
                        <option value="2">2 Jornadas (Mañana y Tarde con descanso)</option>
                        <option value="1">1 Jornada Continua (Todo el día de corrido)</option>
                    </select>
                </div>
                <div class="text-nowrap">
                    <button type="button" id="btnCopiarLunes" class="btn btn-dark btn-sm mt-sm-4">📋 Replicar Lunes</button>
                </div>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th>Cerrado</th>
                            <th id="thJornada1">Jornada 1</th>
                            <th id="thJornada2" class="columna-tarde">Jornada 2</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr data-dia="@i" class="fila-horario">
                                <td>
                                    <input type="hidden" name="horarios[@i].DiaSemana" value="@Model[i].DiaSemana" />
                                    <span class="fw-bold">@dias[Model[i].DiaSemana]</span>
                                </td>
                                <td>
                                    <input type="checkbox" class="form-check-input check-cerrado" name="horarios[@i].EstaCerrado" value="true" @(Model[i].EstaCerrado ? "checked" : "") onchange="validarFila(this.closest('tr'))" />
                                    <input type="hidden" name="horarios[@i].EstaCerrado" value="false" />
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <input type="time" name="horarios[@i].HoraInicio" value="@(Model[i].HoraInicio?.ToString(@"hh\:mm") ?? "08:00")" class="form-control form-control-sm input-hora-inicio" onchange="validarFila(this.closest('tr'))" />
                                        <input type="time" name="horarios[@i].HoraFin" value="@(Model[i].HoraFin?.ToString(@"hh\:mm") ?? "12:00")" class="form-control form-control-sm input-hora-fin" onchange="validarFila(this.closest('tr'))" />
                                    </div>
                                </td>
                                <td class="columna-tarde">
                                    <div class="d-flex gap-1">
                                        <input type="time" name="horarios[@i].HoraInicio2" value="@(Model[i].HoraInicio2?.ToString(@"hh\:mm") ?? "14:00")" class="form-control form-control-sm input-hora-inicio2" onchange="validarFila(this.closest('tr'))" />
                                        <input type="time" name="horarios[@i].HoraFin2" value="@(Model[i].HoraFin2?.ToString(@"hh\:mm") ?? "19:00")" class="form-control form-control-sm input-hora-fin2" onchange="validarFila(this.closest('tr'))" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-success px-5 fw-bold">💾 Guardar y Dar de Alta</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selector = document.getElementById("selectorJornada");
        const thJornada1 = document.getElementById("thJornada1");
        const btnCopiarLunes = document.getElementById("btnCopiarLunes");

            function ajustarJornadas() {
        const esJornadaUnica = selector.value === "1";

        document.querySelectorAll(".columna-tarde").forEach(col => {
            col.style.display = esJornadaUnica ? "none" : "";
        });

        document.querySelectorAll(".fila-horario").forEach(fila => {
            if (esJornadaUnica) {
                thJornada1.textContent = "Horario Completo (Apertura / Cierre)";
                // Vaciamos los inputs de la tarde para que dejen de joder
                fila.querySelector(".input-hora-inicio2").value = "";
                fila.querySelector(".input-hora-fin2").value = "";
            } else {
                thJornada1.textContent = "Jornada Mañana";
            }
            // Forzamos la re-validación de la fila para limpiar los rojos
            validarFila(fila);
        });
    }

        btnCopiarLunes.addEventListener("click", function () {
            const filaLunes = document.querySelector('tr[data-dia="1"]'); // Lunes es 1
            if (!filaLunes) return;

            const cerrado = filaLunes.querySelector(".check-cerrado").checked;
            const ini1 = filaLunes.querySelector(".input-hora-inicio").value;
            const fin1 = filaLunes.querySelector(".input-hora-fin").value;
            const ini2 = filaLunes.querySelector(".input-hora-inicio2").value;
            const fin2 = filaLunes.querySelector(".input-hora-fin2").value;

            document.querySelectorAll(".fila-horario").forEach(fila => {
                if (fila.dataset.dia === "0" || fila.dataset.dia === "1") return; // Ignora Domingo y Lunes

                fila.querySelector(".check-cerrado").checked = cerrado;
                fila.querySelector(".input-hora-inicio").value = ini1;
                fila.querySelector(".input-hora-fin").value = fin1;

                if (selector.value === "2") {
                    fila.querySelector(".input-hora-inicio2").value = ini2;
                    fila.querySelector(".input-hora-fin2").value = fin2;
                } else {
                    fila.querySelector(".input-hora-inicio2").value = "";
                    fila.querySelector(".input-hora-fin2").value = "";
                }
                validarFila(fila);
            });
        });

        selector.addEventListener("change", ajustarJornadas);
        ajustarJornadas();
    });

        function validarFila(fila) {
        const cerrado = fila.querySelector(".check-cerrado").checked;
        const ini1 = fila.querySelector(".input-hora-inicio");
        const fin1 = fila.querySelector(".input-hora-fin");
        const ini2 = fila.querySelector(".input-hora-inicio2");
        const fin2 = fila.querySelector(".input-hora-fin2");

        // Detectamos la monda del selector de jornada
        const tipoJornada = document.getElementById("selectorJornada").value;
        const esJornadaDoble = (tipoJornada === "2");

        // Limpiamos los bordes rojos de entrada siempre
        [ini1, fin1, ini2, fin2].forEach(x => {
            x.style.borderColor = "";
        });

        // Si está cerrado, nos importa un carajo lo que tengan los inputs
        if (cerrado) return;

        // 1. Validar Jornada Mañana / Única (Siempre se valida si está abierto)
        if (ini1.value && fin1.value && ini1.value >= fin1.value) {
            ini1.style.borderColor = "red";
            fin1.style.borderColor = "red";
        }

        // 2. Validar Jornada Tarde (SOLO si el usuario seleccionó las 2 Jornadas)
        if (esJornadaDoble) {
            if (ini2.value && fin2.value && ini2.value >= fin2.value) {
                ini2.style.borderColor = "red";
                fin2.style.borderColor = "red";
            }
            // Validar que no se cruce la mañana con la tarde (lo que salía en image_7bd649.png)
            if (fin1.value && ini2.value && fin1.value >= ini2.value) {
                fin1.style.borderColor = "red";
                ini2.style.borderColor = "red";
            }
        } else {
            // 🔥 SI ES JORNADA ÚNICA: Vaciamos a la fuerza los inputs ocultos
            // para que no manden basura ni confundan al usuario
            ini2.value = "";
            fin2.value = "";
        }
    }

        function aplicarPreset(i1, f1, i2, f2, jornadaTipo) {
        const selector = document.getElementById("selectorJornada");
        selector.value = jornadaTipo;
        selector.dispatchEvent(new Event("change"));

        document.querySelectorAll(".fila-horario").forEach(fila => {
            if (fila.dataset.dia === "0") return; // Saltarse el domingo

            fila.querySelector(".check-cerrado").checked = false;
            fila.querySelector(".input-hora-inicio").value = i1;
            fila.querySelector(".input-hora-fin").value = f1;

            if (jornadaTipo === "2") {
                // Valores lógicos: mañana (08:00 - 12:00) y tarde (14:00 - 19:00)
                fila.querySelector(".input-hora-inicio2").value = i2 ?? "14:00";
                fila.querySelector(".input-hora-fin2").value = f2 ?? "19:00";
            } else {
                fila.querySelector(".input-hora-inicio2").value = "";
                fila.querySelector(".input-hora-fin2").value = "";
            }
            validarFila(fila);
        });
    }
</script>
@model SaaSBarberia.Models.Tenant

@{
    ViewData["Title"] = "Nueva Barbería - Paso 1";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0 text-dark">💈 Registrar Negocio</h3>
            <span class="badge bg-primary fs-6 px-3 py-2">Nuevo Tenant</span>
        </div>
        <p class="text-muted small">Ingresa los datos generales y estéticos de la barbería.</p>

        <form asp-action="Create" enctype="multipart/form-data" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NombreNegocio" class="form-label fw-semibold">Nombre de la Barbería</label>
                <input asp-for="NombreNegocio" class="form-control" placeholder="Ej. El Brayan VIP" required />
                <span asp-validation-for="NombreNegocio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Subdominio" class="form-label fw-semibold">Subdominio de la URL</label>
                <div class="input-group">
                    <input asp-for="Subdominio" class="form-control" placeholder="elbrayan" required />
                    <span class="input-group-text">.barbersaas.com</span>
                </div>
                <span asp-validation-for="Subdominio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-dark">Logo del Establecimiento</label>
                <input type="file" name="logoArchivo" id="logoArchivo" class="form-control" accept="image/*" />
                <small class="text-muted">Se guardará de forma optimizada en el almacenamiento del servidor.</small>
            </div>

            <div class="mb-3">
                <label asp-for="PlanSuscripcion" class="form-label fw-semibold">Plan de Suscripción</label>
                <select asp-for="PlanSuscripcion" class="form-select">
                    <option value="Bronce">Plan Bronce</option>
                    <option value="Oro">Plan Oro</option>
                    <option value="Premium">Plan Premium</option>
                </select>
                <span asp-validation-for="PlanSuscripcion" class="text-danger"></span>
            </div>

            <hr class="my-4" />
            <h5 class="fw-bold text-secondary mb-3">🎨 Personalización Estética</h5>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="ColorPrimario" class="form-label fw-semibold">Color Primario</label>
                    <input asp-for="ColorPrimario" type="color" class="form-control form-control-color w-100" value="#1a1a1a" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ColorSecundario" class="form-label fw-semibold">Color Secundario</label>
                    <input asp-for="ColorSecundario" type="color" class="form-control form-control-color w-100" value="#d4af37" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="EstiloSidebar" class="form-label fw-semibold">Diseño Sidebar</label>
                <select asp-for="EstiloSidebar" class="form-select">
                    <option value="DarkStyle">Estilo Oscuro</option>
                    <option value="LightStyle">Estilo Claro</option>
                </select>
            </div>

            <div class="form-check form-switch mb-3 p-3 card bg-light border-0">
                <div class="ms-4">
                    <input class="form-check-input" type="checkbox" asp-for="TieneModuloHerramientas" id="TieneModuloHerramientas">
                    <label class="form-check-label fw-bold text-dark" for="TieneModuloHerramientas">
                        🔌 Activar Módulo de Alquiler de Herramientas
                    </label>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold text-secondary mb-3">⏱️ Optimización de Tiempos</h5>
            <div class="mb-4 card p-3 bg-light border-0">
                <label asp-for="TiempoEntreCitas" class="form-label fw-bold text-dark">Margen de limpieza/preparación entre citas:</label>
                <select asp-for="TiempoEntreCitas" class="form-select fw-semibold text-success">
                    <option value="0">0 minutos (Seguido)</option>
                    <option value="5">5 minutos</option>
                    <option value="10">10 minutos</option>
                    <option value="15">15 minutos</option>
                </select>
            </div>

            <hr class="my-4" />

            <div class="mb-3 form-check form-switch pt-2">
                <input name="Activo" id="Activo" class="form-check-input" type="checkbox" value="true" checked />
                <input name="Activo" type="hidden" value="false" />
                <label for="Activo" class="form-check-label fw-semibold">Barbería Activa</label>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Regresar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">Siguiente Paso: Horarios ➡️</button>
            </div>
        </form>
    </div>
</div>

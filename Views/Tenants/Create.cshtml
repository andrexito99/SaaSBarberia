@model SaaSBarberia.Models.Tenant

@{
    ViewData["Title"] = "Nueva Barbería";
    var horariosIniciales = ViewBag.HorariosIniciales as List<SaaSBarberia.Models.HorarioLaboral>;
    string[] dias = { "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">💈 Registrar Negocio</h3>

        <form asp-action="Create" enctype="multipart/form-data" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NombreNegocio" class="form-label fw-semibold">Nombre de la Barbería</label>
                <input asp-for="NombreNegocio" class="form-control" placeholder="Ej. El Brayan VIP" required />
                <span asp-validation-for="NombreNegocio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Subdominio" class="form-label fw-semibold">Subdominio de la URL</label>
                <div class="input-group">
                    <input asp-for="Subdominio" class="form-control" placeholder="elbrayan" required />
                    <span class="input-group-text">.barbersaas.com</span>
                </div>
                <span asp-validation-for="Subdominio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-dark">Logo del Establecimiento</label>
                <input type="file" name="logoArchivo" id="logoArchivo" class="form-control" accept="image/*" />
                <small class="text-muted">Se guardará de forma optimizada en el almacenamiento del servidor.</small>
            </div>

            <div class="mb-3">
                <label asp-for="PlanSuscripcion" class="form-label fw-semibold">Plan de Suscripción</label>
                <select asp-for="PlanSuscripcion" class="form-select">
                    <option value="Bronce">Plan Bronce</option>
                    <option value="Oro">Plan Oro</option>
                    <option value="Premium">Plan Premium</option>
                </select>
                <span asp-validation-for="PlanSuscripcion" class="text-danger"></span>
            </div>

            <hr class="my-4" />
            <h5 class="fw-bold text-secondary mb-3">🎨 Personalización Estética</h5>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="ColorPrimario" class="form-label fw-semibold">Color Primario</label>
                    <input asp-for="ColorPrimario" type="color" class="form-control form-control-color w-100" value="#1a1a1a" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ColorSecundario" class="form-label fw-semibold">Color Secundario</label>
                    <input asp-for="ColorSecundario" type="color" class="form-control form-control-color w-100" value="#d4af37" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="EstiloSidebar" class="form-label fw-semibold">Diseño Sidebar</label>
                <select asp-for="EstiloSidebar" class="form-select">
                    <option value="DarkStyle">Estilo Oscuro</option>
                    <option value="LightStyle">Estilo Claro</option>
                </select>
            </div>

            <div class="form-check form-switch mb-3 p-3 card bg-light border-0">
                <div class="ms-4">
                    <input class="form-check-input" type="checkbox" asp-for="TieneModuloHerramientas" id="TieneModuloHerramientas">
                    <label class="form-check-label fw-bold text-dark" for="TieneModuloHerramientas">
                        🔌 Activar Módulo de Alquiler de Herramientas
                    </label>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold text-secondary mb-3">⏱️ Optimización de Tiempos</h5>
            <div class="mb-4 card p-3 bg-light border-0">
                <label asp-for="TiempoEntreCitas" class="form-label fw-bold text-dark">Margen de limpieza/preparación entre citas:</label>
                <select asp-for="TiempoEntreCitas" class="form-select fw-semibold text-success">
                    <option value="0">0 minutos (Seguido)</option>
                    <option value="5">5 minutos</option>
                    <option value="10">10 minutos</option>
                    <option value="15">15 minutos</option>
                </select>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold text-secondary mb-3">📅 Configurar Horarios de Atención</h5>

            <div class="mb-3">
                <label class="form-label fw-semibold text-muted small d-block">Ajustes Rápidos (Presets):</label>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary" onclick="aplicarPreset('08:00', '18:00', null, null, '1')">⚡ 8 AM - 6 PM (Corrido)</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="aplicarPreset('08:00', '12:00', '14:00', '19:00', '2')">⚡ Comercial (2 Jornadas)</button>
                </div>
            </div>

            <div class="mb-3 card p-3 bg-light border-0 d-flex flex-sm-row align-items-center justify-content-between gap-3">
                <div class="flex-grow-1 w-100">
                    <label class="form-label fw-bold text-dark mb-0">Modalidad de Jornada:</label>
                    <select id="selectorJornada" class="form-select form-select-sm mt-1 fw-semibold text-primary">
                        <option value="2">2 Jornadas (Mañana y Tarde con descanso)</option>
                        <option value="1">1 Jornada Continua (Todo el día de corrido)</option>
                    </select>
                </div>
                <div class="text-nowrap">
                    <button type="button" id="btnCopiarLunes" class="btn btn-dark btn-sm mt-sm-4">📋 Replicar Lunes</button>
                </div>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th>Cerrado</th>
                            <th id="thJornada1">Jornada 1</th>
                            <th id="thJornada2" class="columna-tarde">Jornada 2</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < horariosIniciales.Count; i++)
                        {
                            <tr data-dia="@i" class="fila-horario">
                                <td>
                                    <input type="hidden" name="horarios[@i].DiaSemana" value="@horariosIniciales[i].DiaSemana" />
                                    <span class="fw-bold">@dias[horariosIniciales[i].DiaSemana]</span>
                                </td>
                                <td>
                                    <input type="checkbox" class="form-check-input check-cerrado" name="horarios[@i].EstaCerrado" value="true" @(horariosIniciales[i].EstaCerrado ? "checked" : "") onchange="validarFila(this.closest('tr'))" />
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <input type="time" name="horarios[@i].HoraInicio" value="@(horariosIniciales[i].HoraInicio?.ToString(@"hh\:mm") ?? "08:00")" class="form-control form-control-sm input-hora-inicio" onchange="validarFila(this.closest('tr'))" />
                                        <input type="time" name="horarios[@i].HoraFin" value="@(horariosIniciales[i].HoraFin?.ToString(@"hh\:mm") ?? "12:00")" class="form-control form-control-sm input-hora-fin" onchange="validarFila(this.closest('tr'))" />
                                    </div>
                                </td>
                                <td class="columna-tarde">
                                    <div class="d-flex gap-1">
                                        <input type="time" name="horarios[@i].HoraInicio2" value="@(horariosIniciales[i].HoraInicio2?.ToString(@"hh\:mm") ?? "14:00")" class="form-control form-control-sm input-hora-inicio2" onchange="validarFila(this.closest('tr'))" />
                                        <input type="time" name="horarios[@i].HoraFin2" value="@(horariosIniciales[i].HoraFin2?.ToString(@"hh\:mm") ?? "19:00")" class="form-control form-control-sm input-hora-fin2" onchange="validarFila(this.closest('tr'))" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr class="my-4" />

            <div class="mb-3 form-check form-switch pt-2">
                <input name="Activo" id="Activo" class="form-check-input" type="checkbox" value="true" checked />
                <input name="Activo" type="hidden" value="false" />
                <label for="Activo" class="form-check-label fw-semibold">Barbería Activa</label>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Regresar</a>
                <button type="submit" class="btn btn-primary px-4">Dar de Alta</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selector = document.getElementById("selectorJornada");
        const columnasTarde = document.querySelectorAll(".columna-tarde");
        const thJornada1 = document.getElementById("thJornada1");
        const btnCopiarLunes = document.getElementById("btnCopiarLunes");

        function ajustarJornadas() {
            const esJornadaUnica = selector.value === "1";
            columnasTarde.forEach(col => col.style.display = esJornadaUnica ? "none" : "");

            if (esJornadaUnica) {
                thJornada1.textContent = "Horario Completo (Apertura / Cierre)";
                document.querySelectorAll(".input-hora-inicio2, .input-hora-fin2").forEach(input => {
                    input.disabled = true;
                    input.dataset.oldValue = input.value;
                    input.value = "";
                });
            } else {
                thJornada1.textContent = "Jornada Mañana";
                document.querySelectorAll(".input-hora-inicio2, .input-hora-fin2").forEach(input => {
                    input.disabled = false;
                    if(input.dataset.oldValue) input.value = input.dataset.oldValue;
                });
            }
            document.querySelectorAll(".fila-horario").forEach(validarFila);
        }

        btnCopiarLunes.addEventListener("click", function() {
            const filaLunes = document.querySelector('tr[data-dia="1"]');
            const cerradoLunes = filaLunes.querySelector(".check-cerrado").checked;
            const ini1 = filaLunes.querySelector(".input-hora-inicio").value;
            const fin1 = filaLunes.querySelector(".input-hora-fin").value;
            const ini2 = filaLunes.querySelector(".input-hora-inicio2").value;
            const fin2 = filaLunes.querySelector(".input-hora-fin2").value;

            document.querySelectorAll(".fila-horario").forEach(fila => {
                const diaId = fila.getAttribute("data-dia");
                if (diaId !== "1" && diaId !== "0") {
                    fila.querySelector(".check-cerrado").checked = cerradoLunes;
                    fila.querySelector(".input-hora-inicio").value = ini1;
                    fila.querySelector(".input-hora-fin").value = fin1;
                    if (selector.value === "2") {
                        fila.querySelector(".input-hora-inicio2").value = ini2;
                        fila.querySelector(".input-hora-fin2").value = fin2;
                    }
                    validarFila(fila);
                }
            });
        });

        selector.addEventListener("change", ajustarJornadas);
        ajustarJornadas();
    });

    function validarFila(fila) {
        const cerrado = fila.querySelector(".check-cerrado").checked;
        const ini1 = fila.querySelector(".input-hora-inicio");
        const fin1 = fila.querySelector(".input-hora-fin");
        const ini2 = fila.querySelector(".input-hora-inicio2");
        const fin2 = fila.querySelector(".input-hora-fin2");

        [ini1, fin1, ini2, fin2].forEach(i => i.style.borderColor = "");

        if (cerrado) return;

        if (ini1.value && fin1.value && ini1.value >= fin1.value) {
            ini1.style.borderColor = "red";
            fin1.style.borderColor = "red";
        }

        if (!ini2.disabled && ini2.value && fin2.value) {
            if (ini2.value >= fin2.value) {
                ini2.style.borderColor = "red";
                fin2.style.borderColor = "red";
            }
            if (fin1.value && ini2.value <= fin1.value) {
                ini2.style.borderColor = "red";
                fin1.style.borderColor = "red";
            }
        }
    }

    function aplicarPreset(i1, f1, i2, f2,  jornadaTipo) {
        document.getElementById("selectorJornada").value = jornadaTipo;
        document.getElementById("selectorJornada").dispatchEvent(new Event('change'));

        document.querySelectorAll(".fila-horario").forEach(fila => {
            const diaId = fila.getAttribute("data-dia");
            if (diaId !== "0") {
                fila.querySelector(".check-cerrado").checked = false;
                fila.querySelector(".input-hora-inicio").value = i1;
                fila.querySelector(".input-hora-fin").value = f1;
                if (jornadaTipo === "2") {
                    fila.querySelector(".input-hora-inicio2").value = i2;
                    fila.querySelector(".input-hora-fin2").value = f2;
                }
                validarFila(fila);
            }
        });
    }
</script>
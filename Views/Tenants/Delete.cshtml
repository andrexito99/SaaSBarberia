@model SaaSBarberia.Models.Tenant

@{
    ViewData["Title"] = "Suspender Negocio";
}
<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow border-0 p-4 border-top border-danger border-4 text-center">
        <h3 class="text-danger fw-bold">⚠ ¿Eliminar Barbería?</h3>
        <p class="text-muted">Esta acción removerá los registros del negocio "<strong>@Model.NombreNegocio</strong>".</p>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">No, cancelar</a>
                <input type="submit" value="Sí, Eliminar de raíz" class="btn btn-danger px-4" />
            </div>
        </form>
    </div>
</div>
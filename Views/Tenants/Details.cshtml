@model SaaSBarberia.Models.Tenant

@{
    ViewData["Title"] = "Ficha Técnica";
}

<div class="container mt-4" style="max-width: 550px;">
    <div class="card shadow-sm border-0 p-4">

        <div class="text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.RutaLogo))
            {
                <div class="p-2 bg-dark rounded shadow-sm d-inline-block mb-2">
                    <img src="@Model.RutaLogo" class="img-fluid" style="max-height: 80px; object-fit: contain;" alt="Logo @Model.NombreNegocio" />
                </div>
            }
            else
            {
                <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 border shadow-sm" style="width: 80px; height: 80px; font-size: 2.5rem;">
                    💈
                </div>
            }
            <h2 class="text-dark fw-bold mb-0">@Model.NombreNegocio</h2>
            <p class="text-muted small">ID de Inquilino: #@Model.Id</p>
        </div>

        <hr />

        <div class="text-start mb-4">
            <div class="row mb-2">
                <div class="col-sm-4 text-muted fw-semibold">Subdominio:</div>
                <div class="col-sm-8"><code class="text-primary">@(Model.Subdominio).barbersaas.com</code></div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted fw-semibold">Suscripción:</div>
                <div class="col-sm-8"><span class="badge bg-dark px-3">Plan @Model.PlanSuscripcion</span></div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted fw-semibold">Estado:</div>
                <div class="col-sm-8">
                    @(Model.Activo == true ? "🟢 Operando con normalidad" : "🔴 Suspendido / Inactivo")
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted fw-semibold">Margen Citas:</div>
                <div class="col-sm-8 fw-bold text-success">@Model.TiempoEntreCitas minutos entre turnos</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted fw-semibold">Módulo Alquiler:</div>
                <div class="col-sm-8">
                    @(Model.TieneModuloHerramientas ? "✅ Habilitado" : "❌ Desactivado")
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted fw-semibold">Fecha Alta:</div>
                <div class="col-sm-8 text-secondary">@(Model.FechaRegistro?.ToString("dd/MM/yyyy hh:mm tt") ?? "No registrada")</div>
            </div>
        </div>

        <div class="d-flex justify-content-between border-top pt-3">
            <a asp-action="Index" class="btn btn-light border">Volver</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-semibold px-4">Modificar</a>
        </div>
    </div>
</div>
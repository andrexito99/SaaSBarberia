@model SaaSBarberia.Models.Tenant

@{
    ViewData["Title"] = "Editar Barbería";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">Modificar Datos</h3>
        <form asp-action="Edit" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaRegistro" />
            <input type="hidden" asp-for="CerradoPorEmergencia" />
            <input type="hidden" asp-for="FechaUltimoCierre" />

            <div class="mb-3">
                <label asp-for="NombreNegocio" class="form-label fw-semibold">Nombre de la Barbería</label>
                <input asp-for="NombreNegocio" class="form-control" autocomplete="off" />
                <span asp-validation-for="NombreNegocio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Subdominio" class="form-label fw-semibold">Subdominio</label>
                <div class="input-group">
                    <input asp-for="Subdominio" class="form-control" autocomplete="off" />
                    <span class="input-group-text">.barbersaas.com</span>
                </div>
                <span asp-validation-for="Subdominio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlanSuscripcion" class="form-label fw-semibold">Plan</label>
                <select asp-for="PlanSuscripcion" class="form-select">
                    <option value="Bronce">Plan Bronce</option>
                    <option value="Oro">Plan Oro</option>
                    <option value="Premium">Plan Premium</option>
                </select>
                <span asp-validation-for="PlanSuscripcion" class="text-danger"></span>
            </div>

            <hr class="my-4" />
            <h5 class="fw-bold text-secondary mb-3">🎨 Cambiar Identity Estética</h5>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="ColorPrimario" class="form-label fw-semibold">Color de Fondo Navbar</label>
                    <input asp-for="ColorPrimario" type="color" class="form-control form-control-color w-100" title="Elige el color principal" />
                    <span asp-validation-for="ColorPrimario" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ColorSecundario" class="form-label fw-semibold">Color de Detalles / Botones</label>
                    <input asp-for="ColorSecundario" type="color" class="form-control form-control-color w-100" title="Elige el color secundario" />
                    <span asp-validation-for="ColorSecundario" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check form-switch mb-3 card p-3 shadow-sm border-warning">
                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="TieneModuloHerramientas" id="TieneModuloHerramientas">
                <label class="form-check-label fw-bold text-dark" for="TieneModuloHerramientas">
                    🔌 Habilitar Módulo de Alquiler de Máquinas / Herramientas
                </label>
                <small class="text-muted d-block mt-1">Si activas esto, esta barbería tendrá acceso prioritario al inventario y préstamo interno de maquinaria.</small>
            </div>

            <div class="mb-3">
                <label asp-for="EstiloSidebar" class="form-label fw-semibold">Diseño y Posición del Menú</label>
                <select asp-for="EstiloSidebar" class="form-select">
                    <option value="SuperiorClasico">Menú Superior Clásico (Horizontal)</option>
                    <option value="LateralOscuro">Barra Lateral Izquierda (Fondo Oscuro)</option>
                    <option value="LateralClaro">Barra Lateral Izquierda (Fondo Claro)</option>
                </select>
                <span asp-validation-for="EstiloSidebar" class="text-danger"></span>
            </div>

            <hr class="my-4" />

            <!-- ⏱️ SECCIÓN TIEMPO ENTRE CITAS AGREGADA -->
            <h5 class="fw-bold text-secondary mb-3">⏱️ Optimización de Tiempos</h5>
            <div class="mb-4 card p-3 bg-light border-0">
                <label asp-for="TiempoEntreCitas" class="form-label fw-bold text-dark">Margen de limpieza/preparación entre citas:</label>
                <select asp-for="TiempoEntreCitas" class="form-select fw-semibold text-success">
                    <option value="0">0 minutos (Seguido)</option>
                    <option value="5">5 minutos</option>
                    <option value="10">10 minutos</option>
                    <option value="15">15 minutos</option>
                </select>
                <span asp-validation-for="TiempoEntreCitas" class="text-danger"></span>
            </div>

            <hr class="my-4" />

            <div class="mb-3 form-check form-switch pt-2">
                <input type="checkbox" name="Activo" value="true" class="form-check-input" id="Activo" @(Model?.Activo == true ? "checked" : "") />
                <input type="hidden" name="Activo" value="false" />
                <label for="Activo" class="form-check-label fw-semibold">Estado de Cuenta Activo</label>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <div>
                    <a asp-action="ConfigurarHorarios" asp-route-id="@Model.Id" class="btn btn-info text-white me-2">⚙️ Configurar Horarios</a>
                    <button type="submit" class="btn btn-warning px-4">Actualizar</button>
                </div>
            </div>
        </form>
    </div>
</div>
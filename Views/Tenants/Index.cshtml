@model IEnumerable<SaaSBarberia.Models.Tenant>

@{
    ViewData["Title"] = "Panel de Barberías";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">💈 Barberías Registradas (SaaS)</h2>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm">+ Registrar Nueva Barbería</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="position-absolute top-0 end-0 m-3 badge @(item.Activo == true ? "bg-success" : "bg-danger")">
                        @(item.Activo == true ? "Activo" : "Inactivo")
                    </span>

                    <div class="card-body pt-4">
                        <!-- 📸 NUEVO: Header con Logo de la Barbería si existe -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(item.RutaLogo))
                            {
                                <img src="@item.RutaLogo" class="rounded border p-1" style="width: 50px; height: 50px; object-fit: contain;" alt="Logo" />
                            }
                            else
                            {
                                <div class="bg-secondary-subtle border rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.3rem;">
                                    🏬
                                </div>
                            }
                            <div class="text-truncate" style="max-width: 70%;">
                                <h4 class="card-title fw-bold mb-0 text-truncate text-primary">@item.NombreNegocio</h4>
                                <h6 class="text-muted small mb-0">🔗 <code>@(item.Subdominio)</code></h6>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-2">
                            <span class="text-secondary small d-block">Plan Actual:</span>
                            <span class="badge bg-dark">@item.PlanSuscripcion</span>
                        </div>

                        <div>
                            <span class="text-secondary small d-block">Miembro desde:</span>
                            <small class="text-muted">@(item.FechaRegistro?.ToString("dd MMM yyyy") ?? "N/A")</small>
                        </div>
                    </div>

                    <div class="card-footer bg-light border-0 d-flex justify-content-around py-3">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning w-25">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-25">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-25">Borrar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
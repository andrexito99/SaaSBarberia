@model SaaSBarberia.Models.Usuario

@{
    ViewData["Title"] = "Baja de Usuario";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow border-0 p-4 border-top border-danger border-4 text-center">
        <h3 class="text-danger fw-bold">⚠ ¿Dar de baja usuario?</h3>
        <p class="text-muted">Se revocará de forma permanente el acceso a la cuenta de <strong>@Model.Nombre</strong>.</p>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">No, mantener</a>
                <input type="submit" value="Sí, borrar del sistema" class="btn btn-danger px-4" />
            </div>
        </form>
    </div>
</div>
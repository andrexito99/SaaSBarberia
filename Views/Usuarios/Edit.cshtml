@model SaaSBarberia.Models.Usuario

@{
    ViewData["Title"] = "Modificar Usuario";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3 text-dark">Editar Perfil</h3>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre Completo</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordHash" class="form-label fw-semibold">Contraseña (Dejar vacío para no cambiar)</label>
                <input asp-for="PasswordHash" type="password" class="form-control" value="" placeholder="Mantiene la clave actual si no escribes otra" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RoleId" class="form-label fw-semibold">Rol del Sistema</label>
                <select asp-for="RoleId" class="form-select" asp-items="ViewBag.RoleId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="TenantId" class="form-label fw-semibold">Barbería Perteneciente</label>
                <select asp-for="TenantId" class="form-select" asp-items="ViewBag.TenantId">
                    <option value="">-- Ninguno (Administrador del Sistema Global) --</option>
                </select>
            </div>

            <div class="mb-3 form-check form-switch pt-2">
                <input type="checkbox" name="Activo" value="true" class="form-check-input" id="Activo" @(Model?.Activo == true ? "checked" : "") />
                <input type="hidden" name="Activo" value="false" />
                <label for="Activo" class="form-check-label fw-semibold">Cuenta Activa</label>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-warning px-4">Guardar</button>
            </div>
        </form>
    </div>
</div>
@model IEnumerable<SaaSBarberia.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4" data-listing>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white fw-bold m-0 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-warning"></i> Usuarios de la Plataforma
            </h2>
            <p class="text-secondary small mb-0 mt-1">Cuentas de acceso, roles asignados y vinculación a sedes</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Usuario
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h4 class="empty-state-title">No hay usuarios registrados</h4>
            <p class="empty-state-desc">Añade usuarios para otorgar credenciales de acceso a la plataforma.</p>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="bi bi-plus-lg"></i> Registrar Primer Usuario
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" data-listing-grid>
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 position-relative overflow-hidden">
                        <span class="position-absolute top-0 end-0 m-3 badge @(item.Activo == true ? "bg-success" : "bg-danger")">
                            <i class="bi @(item.Activo == true ? "bi-check-circle" : "bi-x-circle")"></i>
                            @(item.Activo == true ? "Activo" : "Inactivo")
                        </span>

                        <div class="card-body p-4 pt-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-circle me-3" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                    @(!string.IsNullOrEmpty(item.Nombre) ? item.Nombre.Substring(0, 1).ToUpper() : "?")
                                </div>
                                <div class="overflow-hidden">
                                    <h5 class="card-title fw-bold mb-0 text-truncate text-white" style="max-width: 170px;">@item.Nombre</h5>
                                    <span class="badge bg-info mt-1">
                                        <i class="bi bi-shield-check me-1"></i>@(item.Role?.NombreRole ?? "Sin Rol")
                                    </span>
                                </div>
                            </div>

                            <hr />

                            <div class="small">
                                <p class="mb-1 text-secondary text-truncate">
                                    <i class="bi bi-envelope me-2 text-warning"></i><span>Correo:</span> 
                                    <span class="text-white">@item.Email</span>
                                </p>
                                <p class="mb-1 text-secondary">
                                    <i class="bi bi-telephone me-2 text-info"></i><span>Teléfono:</span> 
                                    <span class="text-white">@(item.Telefono ?? "No registrado")</span>
                                </p>
                                <p class="mb-0 text-secondary text-truncate">
                                    <i class="bi bi-shop me-2 text-success"></i><span>Barbería:</span> 
                                    <span class="text-white fw-semibold">@(item.Tenant?.NombreNegocio ?? "Acceso Global System")</span>
                                </p>
                            </div>
                        </div>

                        <div class="card-footer d-flex gap-2 justify-content-between">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-fill">
                                <i class="bi bi-pencil me-1"></i>Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info flex-fill">
                                <i class="bi bi-eye me-1"></i>Detalles
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger flex-fill">
                                <i class="bi bi-trash me-1"></i>Borrar
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

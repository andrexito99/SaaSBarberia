@model IEnumerable<SaaSBarberia.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">👥 Usuarios de la Plataforma</h2>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">+ Registrar Nuevo Usuario</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="position-absolute top-0 end-0 m-3 badge @(item.Activo == true ? "bg-success" : "bg-danger")">
                        @(item.Activo == true ? "Activo" : "Inactivo")
                    </span>

                    <div class="card-body pt-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light rounded-circle p-3 text-primary fw-bold me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                @(!string.IsNullOrEmpty(item.Nombre) ? item.Nombre.Substring(0, 1).ToUpper() : "?")
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0 text-truncate" style="max-width: 180px;">@item.Nombre</h5>
                                <span class="badge bg-info text-dark small">@(item.Role?.NombreRole ?? "Sin Rol")</span>
                            </div>
                        </div>

                        <hr />

                        <p class="mb-1 text-muted small">📧 <strong>Correo:</strong> @item.Email</p>
                        <p class="mb-1 text-muted small">📞 <strong>Teléfono:</strong> @(item.Telefono ?? "No registrado")</p>
                        <p class="mb-0 text-muted small">💈 <strong>Barbería:</strong> <span class="text-primary fw-semibold">@(item.Tenant?.NombreNegocio ?? "Acceso Global System")</span></p>
                    </div>

                    <div class="card-footer bg-light border-0 d-flex justify-content-around py-3">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning w-25">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-25">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-25">Borrar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
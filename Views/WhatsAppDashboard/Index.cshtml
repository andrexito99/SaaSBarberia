@model SaaSBarberia.Models.WhatsAppDashboardViewModel
@{ ViewData["Title"] = "Dashboard WhatsApp"; }
<div class="mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3"><div><h3 class="mb-0">WhatsApp Business</h3><span class="text-muted">@Model.NumeroWhatsApp</span></div><span class="badge @(Model.EstadoConexion == "Conectado" ? "bg-success" : Model.EstadoConexion == "Error" ? "bg-danger" : "bg-secondary")">@Model.EstadoConexion</span></div>
  <div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><small>Mensajes enviados hoy</small><strong class="fs-3">@Model.MensajesEnviadosHoy</strong></div></div><div class="col-md-4"><div class="card card-body"><small>Recordatorios enviados</small><strong class="fs-3">@Model.RecordatoriosEnviados</strong></div></div><div class="col-md-4"><div class="card card-body"><small>Confirmaciones enviadas</small><strong class="fs-3">@Model.ConfirmacionesEnviadas</strong></div></div><div class="col-md-4"><div class="card card-body"><small>Cancelaciones</small><strong class="fs-3">@Model.CancelacionesEnviadas</strong></div></div><div class="col-md-4"><div class="card card-body"><small>Reprogramaciones</small><strong class="fs-3">@Model.ReprogramacionesEnviadas</strong></div></div></div>
  <div class="card shadow-sm border-0"><div class="card-header bg-white"><strong>Últimos mensajes</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Hora</th><th>Cliente</th><th>Tipo</th><th>Estado</th></tr></thead><tbody>@foreach (var mensaje in Model.UltimosMensajes) { <tr><td>@mensaje.Fecha.ToLocalTime().ToString("dd/MM HH:mm")</td><td>@mensaje.Cliente?.Nombre</td><td>@mensaje.Tipo</td><td>@mensaje.Estado</td></tr> }</tbody></table></div></div>
</div>

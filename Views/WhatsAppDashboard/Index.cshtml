@model SaaSBarberia.Models.WhatsAppDashboardViewModel
@{ 
    ViewData["Title"] = "Dashboard WhatsApp"; 
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white m-0 d-flex align-items-center gap-2">
                <i class="bi bi-whatsapp text-success"></i> Panel WhatsApp Business
            </h2>
            <p class="text-secondary small mb-0 mt-1">Línea conectada: <span class="text-white fw-semibold">@Model.NumeroWhatsApp</span></p>
        </div>
        <span class="badge @(Model.EstadoConexion == "Conectado" ? "bg-success" : Model.EstadoConexion == "Error" ? "bg-danger" : "bg-secondary") px-3 py-2 fs-7">
            <i class="bi @(Model.EstadoConexion == "Conectado" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
            @Model.EstadoConexion
        </span>
    </div>

    <!-- KPIs WhatsApp -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Enviados Hoy</span>
                    <div class="kpi-icon-wrapper kpi-icon-emerald">
                        <i class="bi bi-send-fill"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.MensajesEnviadosHoy</div>
                <div class="kpi-subtitle"><span class="text-secondary">Total despachados</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Recordatorios</span>
                    <div class="kpi-icon-wrapper kpi-icon-amber">
                        <i class="bi bi-alarm-fill"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.RecordatoriosEnviados</div>
                <div class="kpi-subtitle"><span class="text-secondary">Alertas de turno</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Confirmados</span>
                    <div class="kpi-icon-wrapper kpi-icon-blue">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.ConfirmacionesEnviadas</div>
                <div class="kpi-subtitle"><span class="text-secondary">Citas ratificadas</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Cancelados</span>
                    <div class="kpi-icon-wrapper kpi-icon-rose">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.CancelacionesEnviadas</div>
                <div class="kpi-subtitle"><span class="text-secondary">Avisos de anulación</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-header">
                    <span class="kpi-title">Reprogramados</span>
                    <div class="kpi-icon-wrapper kpi-icon-purple">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>
                <div class="kpi-value text-white">@Model.ReprogramacionesEnviadas</div>
                <div class="kpi-subtitle"><span class="text-secondary">Cambios de fecha</span></div>
            </div>
        </div>
    </div>

    <!-- Tabla de Últimos Mensajes -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold text-white d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text text-info"></i> Últimos Mensajes Despachados
            </span>
            <a asp-controller="WhatsAppHistorial" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver historial</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hora</th>
                        <th>Cliente</th>
                        <th>Tipo Mensaje</th>
                        <th>Estado Entrega</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UltimosMensajes == null || !Model.UltimosMensajes.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="empty-state border-0 my-0 py-3">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-chat-square-dots"></i>
                                    </div>
                                    <h5 class="empty-state-title">No hay mensajes recientes</h5>
                                    <p class="empty-state-desc">Aún no se han despachado notificaciones automáticas vía WhatsApp.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var mensaje in Model.UltimosMensajes)
                        {
                            <tr>
                                <td class="text-secondary">
                                    <i class="bi bi-clock me-1 text-muted"></i>@mensaje.Fecha.ToLocalTime().ToString("dd/MM HH:mm")
                                </td>
                                <td class="fw-bold text-white">@(mensaje.Cliente?.Nombre ?? "Cliente")</td>
                                <td>
                                    <span class="badge bg-info">@mensaje.Tipo</span>
                                </td>
                                <td>
                                    <span class="badge @(mensaje.Estado == "Enviado" || mensaje.Estado == "Entregado" || mensaje.Estado == "Leido" ? "bg-success" : "bg-danger")">
                                        <i class="bi @(mensaje.Estado == "Enviado" || mensaje.Estado == "Entregado" || mensaje.Estado == "Leido" ? "bi-check2-all" : "bi-exclamation-circle")"></i>
                                        @mensaje.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

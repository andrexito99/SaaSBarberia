@model IEnumerable<SaaSBarberia.Models.WhatsAppMensajeHistorial>
@{ ViewData["Title"] = "Historial WhatsApp"; var tipos = ViewBag.Tipos as IEnumerable<string> ?? Array.Empty<string>(); }
<div class="mt-4"><h3>📨 Historial de mensajes WhatsApp</h3>
<form method="get" class="card card-body border-0 shadow-sm mt-3"><div class="row g-2"><div class="col-md-3"><label class="form-label">Desde</label><input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="form-control" /></div><div class="col-md-3"><label class="form-label">Hasta</label><input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="form-control" /></div><div class="col-md-3"><label class="form-label">Tipo</label><select name="tipo" class="form-select"><option value="">Todos</option>@foreach (var tipo in tipos) { <option value="@tipo" selected="@(tipo == ViewBag.Tipo)">@tipo</option> }</select></div><div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-primary">Filtrar</button><a asp-action="Index" class="btn btn-light border">Limpiar</a></div></div></form>
<div class="card shadow-sm border-0 mt-3"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Fecha</th><th>Cliente</th><th>Teléfono</th><th>Tipo</th><th>Mensaje</th><th>Estado</th><th>Error</th><th>MetaMessageId</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Cliente?.Nombre</td><td>@item.Telefono</td><td>@item.Tipo</td><td style="max-width:360px">@item.Mensaje</td><td><span class="badge @(item.Estado == "Enviado" ? "bg-success" : item.Estado == "Error" ? "bg-danger" : "bg-secondary")">@item.Estado</span></td><td class="text-danger" style="max-width:260px">@item.Error</td><td class="small">@item.MetaMessageId</td></tr> }</tbody></table></div></div></div>

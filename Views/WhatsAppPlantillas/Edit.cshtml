@model SaaSBarberia.Models.WhatsAppPlantilla
@{ ViewData["Title"] = "Editar plantilla WhatsApp"; }
<div class="container mt-4" style="max-width:800px"><div class="card shadow-sm border-0 p-4"><h3>📝 Plantilla WhatsApp</h3><p class="text-muted">Variables disponibles: {Cliente}, {Barbero}, {Servicio}, {Fecha}, {Hora}, {Barberia}.</p><form asp-action="Edit"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Tipo" class="form-label">Tipo</label><select asp-for="Tipo" class="form-select"><option value="">Selecciona</option>@foreach (var tipo in SaaSBarberia.Controllers.WhatsAppPlantillasController.TiposPermitidos) { <option value="@tipo">@tipo</option> }</select><span asp-validation-for="Tipo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Contenido" class="form-label">Contenido</label><textarea asp-for="Contenido" class="form-control" rows="7"></textarea><span asp-validation-for="Contenido" class="text-danger"></span></div><div class="form-check"><input asp-for="Activa" class="form-check-input"/><label asp-for="Activa" class="form-check-label">Plantilla activa</label></div><div class="mt-4"><a asp-action="Index" class="btn btn-light border">Cancelar</a><button class="btn btn-success">Guardar</button></div></form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

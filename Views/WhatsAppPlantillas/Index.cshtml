@model IEnumerable<SaaSBarberia.Models.WhatsAppPlantilla>
@{ ViewData["Title"] = "Plantillas WhatsApp"; }
<div class="d-flex justify-content-between align-items-center mt-4 mb-3"><div><h3 class="mb-0">📝 Plantillas WhatsApp</h3><small class="text-muted">Variables: {Cliente}, {Barbero}, {Servicio}, {Fecha}, {Hora}, {Barberia}</small></div><a asp-action="Edit" class="btn btn-success">Nueva plantilla</a></div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Tipo</th><th>Mensaje</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.Tipo</td><td class="text-truncate" style="max-width:500px">@item.Contenido</td><td><span class="badge @(item.Activa ? "bg-success" : "bg-secondary")">@(item.Activa ? "Activa" : "Inactiva")</span></td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger swal-confirm" data-message="¿Eliminar esta plantilla?" type="button">Eliminar</button></form></td></tr> }</tbody></table></div></div>
